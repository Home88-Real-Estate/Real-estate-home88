# ---------------------------------------------------------------------------
# CRM environment. Copy to apps/crm/.env.local for local dev, or set these in
# the hosting project (Vercel) for the CRM deployment. Names only here; NEVER
# commit filled-in values. No secret belongs in a NEXT_PUBLIC_ variable.
#
# The CRM holds no database credentials: the browser talks only to this origin,
# and this server forwards the session cookie to the API over API_URL. All DB
# access happens inside apps/api.
# ---------------------------------------------------------------------------

# --- Server-only (never exposed to the browser) -----------------------------
# Origin of the API (apps/api). In production this is the deployed API, e.g.
# https://api.home88.estate. Defaults to http://localhost:4000 when unset.
API_URL="http://localhost:4000"
# Must match SESSION_COOKIE_NAME on the API.
SESSION_COOKIE_NAME="h88_session"
# Origins the CRM is reached through when the public site proxies /crm to it
# (comma-separated). Needed so form submissions (server actions) are accepted,
# e.g. "https://realestate-home-88.vercel.app,https://home88.estate".
CRM_PUBLIC_ORIGINS=""

# --- Public (safe to expose; inlined into the client bundle at BUILD time) --
# Public origin the CRM is served from, used to build absolute links (e.g. the
# staff sign-in link on the public website is <NEXT_PUBLIC_CRM_URL>/crm/login).
# Production: https://crm.home88.estate — never a localhost placeholder.
NEXT_PUBLIC_CRM_URL="http://localhost:3100"
# Path prefix (Next `basePath`). Changing this requires a rebuild AND matching
# CRM_BASE_PATH on the API and NEXT_PUBLIC_CRM_BASE_PATH on the public website.
NEXT_PUBLIC_CRM_BASE_PATH="/crm"
# Optional object-storage origin allowed in img-src/media-src for uploads.
NEXT_PUBLIC_MEDIA_BASE_URL=""

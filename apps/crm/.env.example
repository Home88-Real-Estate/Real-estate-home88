# ---------------------------------------------------------------------------
# CRM + API environment: the "HOME88 CRM" Vercel project (root apps/crm).
# Copy to apps/crm/.env.local for local dev. Names only here; NEVER commit
# filled-in values. No secret belongs in a NEXT_PUBLIC_ variable.
#
# In production the API (apps/api) runs inside this deployment, so this
# project holds the API's server-only secrets as well. The browser never sees
# them: it talks only to this origin, and only the server reads these values.
# See docs/deployment.md.
# ---------------------------------------------------------------------------

# --- API location ------------------------------------------------------------
# Leave EMPTY in production: the API then runs in-process. Set it only to use a
# separately running API, e.g. "http://localhost:4000" with `npm run dev`.
API_URL=""

# --- Database (server-only) ----------------------------------------------------
DATABASE_URL=""

# --- Auth (server-only) ----------------------------------------------------------
# At least 32 characters in production or the API refuses to start.
JWT_SECRET=""
SESSION_COOKIE_NAME="h88_session"
SESSION_TTL_HOURS="12"
PASSWORD_HASH_ROUNDS="12"

# --- URLs ----------------------------------------------------------------------
# This CRM's public origin: password-reset links and the API's CSRF check use it.
CRM_URL="https://real-estate-home88-iota.vercel.app"
CRM_BASE_PATH="/crm"
# The public website's origin (also allowed by the API's CSRF check).
SITE_URL="https://realestate-home-88.vercel.app"
# Only if the website ALSO serves the CRM under its own /crm (CRM_ORIGIN on the
# web project): those origins, comma-separated, so CRM forms are accepted there.
CRM_PUBLIC_ORIGINS=""

# --- Object storage for photos/documents (server-only) ----------------------
# Any S3-compatible service (e.g. Supabase Storage's S3 endpoint, Cloudflare R2).
# Browsers upload straight to it with signed URLs, so the bucket needs a CORS
# rule allowing PUT from CRM_URL (see docs/deployment.md).
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_FORCE_PATH_STYLE="true"
S3_SIGNED_URL_TTL="900"
# Largest single file a signed upload may declare (25 MB).
MAX_UPLOAD_BYTES="26214400"

# --- Personal-data protection (server-only; same values as the website) ------
PII_HASH_PEPPER=""
PII_ENCRYPTION_KEY=""
UNSUBSCRIBE_SECRET=""

# --- Email (server-only). Blank SMTP_HOST = log-only, nothing is delivered ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="HOME88"

# --- Company details used in emails -------------------------------------------
COMPANY_LEGAL_NAME="HOME88"
COMPANY_PRIVACY_EMAIL=""

# --- Public (inlined into the browser bundle at BUILD time) -------------------
# Must match CRM_BASE_PATH. Changing it requires a rebuild.
NEXT_PUBLIC_CRM_BASE_PATH="/crm"
# Optional public media origin (if approved media is served from a CDN).
NEXT_PUBLIC_MEDIA_BASE_URL=""

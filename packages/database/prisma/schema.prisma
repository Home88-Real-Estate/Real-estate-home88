// ---------------------------------------------------------------------------
// Reference counters
//
// Postgres sequences cannot produce "H88-000001" without a function per
// prefix, and they cannot be reseeded independently per environment. A counter
// table is portable and makes the allocation transactional with the insert.
// ---------------------------------------------------------------------------

model ReferenceCounter {
  id        String   @id @default(cuid())
  scope     String   @unique
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// scrypt hash of the user's password. Null until the person sets one
  /// through the reset/invitation flow (e.g. the bootstrapped first admin):
  /// a null hash never authenticates.
  passwordHash String?
  /// The user's id in an external identity provider (the Supabase Auth
  /// `auth.users.id` of the same person), when one exists. Recorded so the
  /// same identity can never be mapped to two staff records. CRM sign-in does
  /// not use it: credentials are this table's own.
  authUid      String?    @unique @db.Uuid
  firstName    String
  lastName     String
  phone        String?
  role         UserRole   @default(AGENT)
  status       UserStatus @default(ACTIVE)

  /// Set by the age gate at invite/creation time. Users of this CRM are staff,
  /// so this is enforced rather than merely recorded.
  dateOfBirth DateTime? @db.Date

  /// May approve the legal wording of document templates. Separate from every
  /// CRM role: an administrator is not a legal approver unless a Super Admin says so.
  legalApprover Boolean @default(false)

  avatarUrl String?
  locale    String  @default("el")

  properties          Property[]           @relation("PropertyAgent")
  ownedBy             Property[]           @relation("PropertyCreator")
  leads               Lead[]               @relation("LeadAssignee")
  viewings            Viewing[]
  showingsResponsible Showing[]            @relation("ShowingResponsible")
  tasks               Task[]               @relation("TaskAssignee")
  assignedContacts    Contact[]            @relation("ContactAssignee")
  buyerRequests       BuyerRequest[]       @relation("RequestAssignee")
  submissions         PropertySubmission[] @relation("SubmissionAssignee")
  notes               Note[]
  offers              Offer[]              @relation("OfferAgent")
  transactions        Transaction[]        @relation("TransactionAgent")
  sellerLeads         SellerLead[]         @relation("SellerLeadAgent")
  valuations          Valuation[]          @relation("ValuationAgent")
  mandates            Mandate[]            @relation("MandateAgent")
  messagesSent        Message[]            @relation("MessageSender")
  aiRequests          AiRequest[]          @relation("AiRequestUser")
  auditLogs           AuditLog[]
  consents            ConsentRecord[]
  createdBy           User?                @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById         String?
  createdUsers        User[]               @relation("UserCreatedBy")
  deactivatedBy       User?                @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedById     String?
  deactivatedUsers    User[]               @relation("UserDeactivatedBy")
  deactivatedAt       DateTime?
  deletionRequestedAt DateTime?
  erasureCompletedAt  DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  propertyStatusChanges     PropertyStatusHistory[]
  propertyPriceChanges      PropertyPriceHistory[]
  invitationsSent           Invitation[]            @relation("InvitationInviter")
  assignedValuationRequests ValuationRequest[]      @relation("ValuationRequestAgent")

  @@index([role])
  @@index([status])
  @@index([email])
  @@map("users")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token that lives in the HttpOnly cookie. The raw
  /// token is never stored, so a database leak cannot be replayed as a session.
  tokenHash     String    @unique
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A staff invitation. An admin creates one; the invitee redeems it once to
/// create an ACTIVE user. Kept separate from User so no password (or a
/// placeholder hash) exists before the person sets their own.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole  @default(AGENT)
  firstName   String
  lastName    String
  phone       String?
  /// SHA-256 of the opaque token in the emailed link. The raw token is never stored.
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// People: owners, buyers, sellers, landlords, tenants
// ---------------------------------------------------------------------------

model Contact {
  id        String @id @default(cuid())
  reference String @unique

  firstName String
  lastName  String
  company   String?

  /// Held at rest encrypted; see apps/api for the envelope key. Never selected
  /// into list views or logs.
  emailEncrypted  String?
  emailHash       String?
  /// Peppered hash of the normalised phone, so the same person is found by
  /// number without the number being searchable in the clear.
  phoneHash       String?
  phoneEncrypted  String?
  mobileEncrypted String?

  roles            ContactRole[]
  taxIdEncrypted   String?
  addressEncrypted String?

  // --- Contact workspace (Phase C) -----------------------------------------
  status             ContactStatus @default(ACTIVE)
  /// The user who looks after this contact (Διαχειριστής).
  assignedToId       String?
  assignedTo         User?         @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Bumped when something happens with the contact (note, showing, reminder, request ...).
  lastActivityAt     DateTime?
  city               String?
  postalCode         String?
  workPhoneEncrypted String?
  tasks              Task[]

  preferredContactMethod PreferredContactMethod @default(ANY)
  preferredLocale        String                 @default("el")

  notes              Note[]
  leads              Lead[]
  viewings           Viewing[]
  buyerRequests      BuyerRequest[]
  offers             Offer[]
  properties         Property[]           @relation("PropertyOwner")
  buyerTransactions  Transaction[]        @relation("TransactionBuyer")
  sellerTransactions Transaction[]        @relation("TransactionSeller")
  sellerLeads        SellerLead[]
  mandateParties     MandateParty[]
  propertyOwnerships PropertyOwner[]
  showings           Showing[]
  showingParties     ShowingParty[]
  documents          Document[]
  submissions        PropertySubmission[]
  viewingRequests    ViewingRequest[]
  uploadedMedia      PropertyMedia[]

  marketingOptOutAt  DateTime?
  /// Set when the person replied STOP or asked for no SMS.
  smsOptOutAt        DateTime?
  messages           Message[]
  erasureRequestedAt DateTime?
  retentionExpiresAt DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  valuationRequests ValuationRequest[]
  ContactProperty   ContactProperty[]

  @@index([emailHash])
  @@index([phoneHash])
  @@index([lastName])
  @@index([assignedToId])
  @@index([status])
  @@index([lastActivityAt])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Property
// ---------------------------------------------------------------------------

model Property {
  id        String @id @default(cuid())
  /// Public code, e.g. H88-000001. Allocated from ReferenceCounter('property').
  reference String @unique

  /// URL slug. Unique, and regenerated when the title changes.
  slug String @unique

  listingType  ListingType
  propertyType PropertyType
  status       PropertyStatus    @default(DRAFT)
  condition    PropertyCondition @default(GOOD)

  titleEl String
  titleEn String?

  descriptionEl String
  descriptionEn String?

  price          Decimal? @db.Decimal(14, 2)
  priceOnRequest Boolean  @default(false)
  /// Monthly price for RENT; total price for SALE. Lets offers sort correctly.
  monthlyRent    Decimal? @db.Decimal(14, 2)

  area      Decimal? @db.Decimal(10, 2)
  plotArea  Decimal? @db.Decimal(10, 2)
  builtArea Decimal? @db.Decimal(10, 2)

  bedrooms    Int?
  bathrooms   Int?
  wc          Int?
  floor       Int?
  totalFloors Int?

  yearBuilt     Int?
  yearRenovated Int?

  heating     HeatingType @default(NOT_AVAILABLE)
  energyClass EnergyClass @default(NOT_AVAILABLE)
  hasSolar    Boolean     @default(false)

  parking         Boolean  @default(false)
  parkingSpaces   Int?
  storage         Boolean  @default(false)
  balcony         Boolean  @default(false)
  balconyArea     Decimal? @db.Decimal(8, 2)
  garden          Boolean  @default(false)
  pool            Boolean  @default(false)
  furnished       Boolean  @default(false)
  petsAllowed     Boolean  @default(false)
  seaView         Boolean  @default(false)
  newConstruction Boolean  @default(false)

  region       String?
  city         String?
  areaName     String?
  neighborhood String?
  address      String?
  postalCode   String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  videoUrl       String?
  virtualTourUrl String?

  /// Surfaced on the website once true. Independent of PropertyStatus so a
  /// listing can be hidden without being delisted from portals.
  publishedOnWebsite Boolean   @default(false)
  publishedAt        DateTime?
  featured           Boolean   @default(false)

  agentId String?
  agent   User?   @relation("PropertyAgent", fields: [agentId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   Contact? @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PropertyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  media             PropertyMedia[]
  leads             Lead[]
  owners            PropertyOwner[]
  contactLinks      ContactProperty[]
  showingProperties ShowingProperty[]
  viewings          Viewing[]
  offers            Offer[]
  transactions      Transaction[]
  sellerLeads       SellerLead[]
  valuations        Valuation[]
  comparableIn      ValuationComparable[]
  mandates          Mandate[]
  messages          Message[]
  documents         Document[]
  portalListings    PortalListing[]
  tagAssignments    PropertyTagAssignment[]
  notes             Note[]
  dmcaNotices       DmcaNotice[]
  tasks             Task[]
  statusHistory     PropertyStatusHistory[]
  priceHistory      PropertyPriceHistory[]
  submissionsLinked PropertySubmission[]

  /// Commission is stored as a rate, not a hard-coded percentage.
  commissionRatePct  Decimal? @db.Decimal(5, 2)
  agentCommissionPct Decimal? @db.Decimal(5, 2)
  /// Type- and listing-specific attributes, validated by property-profiles in @home88/domain.
  details            Json?

  /// Non-nullable retention anchor, used by the purge job.
  retentionExpiresAt DateTime?

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  ViewingRequest              ViewingRequest[]
  valuationRequestComparables ValuationRequestComparable[]

  @@index([status])
  @@index([listingType])
  @@index([propertyType])
  @@index([reference])
  @@index([publishedOnWebsite, status])
  @@index([city])
  @@index([neighborhood])
  @@index([price])
  @@index([area])
  @@index([bedrooms])
  @@index([agentId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("properties")
}

/// Every status transition, written in the same transaction as the change.
/// `fromStatus` is null only for a property's creation.
model PropertyStatusHistory {
  id         String          @id @default(cuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromStatus PropertyStatus?
  toStatus   PropertyStatus
  reason     String?
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([propertyId, createdAt])
  @@index([toStatus, createdAt])
  @@map("property_status_history")
}

/// Asking price / monthly rent changes. Prices are never overwritten without
/// a row here, so reductions and time-at-price can be reported.
model PropertyPriceHistory {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromPrice       Decimal? @db.Decimal(14, 2)
  toPrice         Decimal? @db.Decimal(14, 2)
  fromMonthlyRent Decimal? @db.Decimal(14, 2)
  toMonthlyRent   Decimal? @db.Decimal(14, 2)
  actorId         String?
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([propertyId, createdAt])
  @@map("property_price_history")
}

model PropertyMedia {
  id                  String              @id @default(cuid())
  /// Null while the file belongs to an owner submission and has not been
  /// attached to a property. Such a row is private whatever its status says.
  propertyId          String?
  property            Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  submissionId        String?
  submission          PropertySubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  /// Who supplied it, when it came from a customer rather than staff.
  uploadedByContactId String?
  uploadedByContact   Contact?            @relation(fields: [uploadedByContactId], references: [id], onDelete: SetNull)

  source         MediaSource    @default(AGENT_UPLOAD)
  lifecycle      MediaLifecycle @default(AVAILABLE)
  /// Why a file was quarantined or rejected. Safe to show staff.
  processingNote String?
  /// SHA-256 of the original bytes, to spot an exact duplicate.
  checksum       String?

  kind MediaKind @default(PHOTO)

  /// Object-storage key, never a public URL. A signed URL is generated per
  /// request so a leaked link expires. Unique: confirming the same upload
  /// twice (a retry) never creates a second row.
  storageKey   String  @unique
  /// Browser-made web-sized JPEG (long edge ≤ 2048px) and thumbnail of a
  /// photo, stored next to the original. Null for older rows and non-images.
  previewKey   String?
  thumbnailKey String?
  originalName String?
  mimeType     String
  byteSize     Int
  width        Int?
  height       Int?

  altEl String?
  altEn String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  /// Moderation state. Nothing uploads straight to public-serving state.
  status String @default("pending_review")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, kind, sortOrder])
  @@index([propertyId, isPrimary])
  @@index([submissionId])
  @@index([checksum])
  @@index([status])
  @@map("property_media")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id        String @id @default(cuid())
  /// Public code, e.g. H88-000184. Allocated from ReferenceCounter('lead').
  reference String @unique

  firstName String
  lastName  String?
  email     String?
  phone     String?
  message   String?

  status          LeadStatus @default(NEW)
  /// What kind of opportunity this is, independent of where it came from.
  type            LeadType   @default(GENERAL_INQUIRY)
  source          LeadSource @default(WEBSITE)
  /// Coarse channel (GOOGLE, INSTAGRAM, ...), derived from the referrer or an
  /// allowed UTM source. Never the raw referrer URL.
  sourceChannel   String?
  /// Path only (no host, no query string) of the page the form was on.
  landingPage     String?
  /// Hostname only of the referring site.
  referrerHost    String?
  /// Campaign tags are stored only when the visitor allowed measurement.
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  /// Portal-side identifiers, so a lead can be traced back to its origin.
  sourcePortalId  String?
  sourceListingId String?
  sourceUrl       String?

  preferredContactMethod PreferredContactMethod @default(ANY)
  locale                 String                 @default("el")

  budgetMin Decimal? @db.Decimal(14, 2)
  budgetMax Decimal? @db.Decimal(14, 2)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  buyerRequestId String?
  buyerRequest   BuyerRequest? @relation(fields: [buyerRequestId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  notes           Note[]
  viewings        Viewing[]
  showings        Showing[]
  offers          Offer[]
  tasks           Task[]
  transactions    Transaction[]
  submissions     PropertySubmission[]
  viewingRequests ViewingRequest[]

  /// Compliance state for this enquiry.
  consentRecordId    String?
  marketingOptOutAt  DateTime?
  retentionExpiresAt DateTime?
  erasureRequestedAt DateTime?

  /// Verified at capture time by the server-side age gate. Stored as a boolean
  /// decision, never a raw date of birth.
  ageVerifiedAt       DateTime?
  ageVerificationFail Boolean   @default(false)

  lastContactedAt DateTime?
  nextActionAt    DateTime?
  lostReason      String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  valuationRequests ValuationRequest[]

  @@index([status])
  @@index([type, status])
  @@index([source])
  @@index([sourcePortalId])
  @@index([assignedToId, status])
  @@index([propertyId])
  @@index([createdAt])
  @@index([nextActionAt])
  @@index([assignedToId, createdAt])
  @@map("leads")
}

model Note {
  id        String  @id @default(cuid())
  body      String
  isPrivate Boolean @default(false)

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([propertyId])
  @@map("notes")
}

model Viewing {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Snapshot of who attended, kept even if the linked contact is later erased.
  clientName  String
  clientPhone String?
  clientEmail String?

  startsAt DateTime
  endsAt   DateTime?
  status   ViewingStatus @default(SCHEDULED)
  feedback String?
  outcome  String?

  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tasks          Task[]
  /// When the agent was reminded of the appointment (sent once).
  reminderSentAt DateTime?

  /// The signed Υπόδειξη this appointment led to, if any. A Viewing stays the
  /// operational appointment; the Showing is the legal document.
  showingId String?
  showing   Showing?  @relation("ShowingViewings", fields: [showingId], references: [id], onDelete: SetNull)
  sourceFor Showing[] @relation("ShowingSourceViewing")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, startsAt])
  @@index([agentId, startsAt])
  @@index([status])
  @@index([status, startsAt])
  @@index([startsAt])
  @@index([showingId])
  @@map("viewings")
}

model Offer {
  id        String @id @default(cuid())
  reference String @unique

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  amount     Decimal     @db.Decimal(14, 2)
  status     OfferStatus @default(SUBMITTED)
  conditions String?
  expiresAt  DateTime?
  notes      String?

  agentId String?
  agent   User?   @relation("OfferAgent", fields: [agentId], references: [id], onDelete: SetNull)

  commissionAmount      Decimal?  @db.Decimal(14, 2)
  agentCommissionAmount Decimal?  @db.Decimal(14, 2)
  closedAt              DateTime?

  /// Negotiation round. Rounds are never edited: a counter-offer is a new row
  /// pointing at the round it answers, and the database refuses changes to a
  /// round's terms (see migration 20261009010000_transactions).
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  parentOfferId String?
  parentOffer   Offer?       @relation("OfferCounter", fields: [parentOfferId], references: [id], onDelete: Restrict)
  counters      Offer[]      @relation("OfferCounter")
  /// Who proposed these terms: BUYER (or tenant) or SELLER (owner).
  party         String       @default("BUYER")
  round         Int          @default(1)
  financing     String?
  deposit       Decimal?     @db.Decimal(14, 2)
  createdById   String?
  respondedAt   DateTime?
  respondedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([leadId])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@index([transactionId, round])
  @@map("offers")
}

/// A client's search criteria (Ζήτηση): what they want to buy or rent.
/// Matched against properties by @home88/domain request-matching.
model BuyerRequest {
  id        String @id @default(cuid())
  reference String @unique

  status        RequestStatus  @default(ACTIVE)
  listingType   ListingType
  /// Empty = any type.
  propertyTypes PropertyType[]
  /// Free-text areas (city, area or neighbourhood names).
  areas         String[]

  minPrice     Decimal? @db.Decimal(14, 2)
  maxPrice     Decimal? @db.Decimal(14, 2)
  minArea      Decimal? @db.Decimal(10, 2)
  maxArea      Decimal? @db.Decimal(10, 2)
  minBedrooms  Int?
  minBathrooms Int?
  minFloor     Int?
  minYearBuilt Int?
  /// Required features, as property-profile keys (parking, storage, elevator, ...).
  features     String[]

  clientName  String
  clientPhone String?
  clientEmail String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leads       Lead[]

  /// 1-5: how promising the client is.
  rating    Int?
  notes     String?
  expiresAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, listingType])
  @@index([assignedToId, status])
  @@index([createdAt])
  @@map("buyer_requests")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(NORMAL)

  dueAt       DateTime?
  completedAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewingId  String?
  viewing    Viewing?  @relation(fields: [viewingId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  showingId  String?
  showing    Showing?  @relation(fields: [showingId], references: [id], onDelete: Cascade)

  /// When the assignee was told the task is due (sent once).
  dueNotifiedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedToId, status])
  @@index([contactId])
  @@index([showingId])
  @@index([dueAt])
  @@index([status, priority])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Documents
//
// Never a public bucket. Every read goes through a signed URL after an
// authorisation check.
// ---------------------------------------------------------------------------

model Document {
  id         String    @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Set while the file belongs to an owner submission. CRM-private always.
  submissionId String?
  submission   PropertySubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  ownerAuthorities PropertyOwner[] @relation("OwnerAuthorityDocument")

  title          String
  category       DocumentCategory @default(OTHER)
  storageKey     String
  mimeType       String
  byteSize       Int
  checksum       String?
  originalName   String?
  source         MediaSource      @default(AGENT_UPLOAD)
  lifecycle      MediaLifecycle   @default(AVAILABLE)
  processingNote String?

  /// Documents containing personal data are removed with the person.
  containsPersonalData Boolean   @default(false)
  retentionExpiresAt   DateTime?

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactionId   String?
  transaction     Transaction?               @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  checklistItems  TransactionChecklistItem[]
  mandatePdfOf    Mandate?                   @relation("MandatePdf")
  mandateSignedOf Mandate?                   @relation("MandateSignedCopy")

  @@index([propertyId])
  @@index([transactionId])
  @@index([contactId])
  @@index([submissionId])
  @@index([retentionExpiresAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Portal publishing
//
// A portal is a configuration row. How it is written to is a PortalAdapter, so
// adding Spitogatos or XE.gr never touches the property code.
// ---------------------------------------------------------------------------

model Portal {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  transport PortalTransport @default(MANUAL)
  enabled   Boolean         @default(false)

  baseUrl        String?
  feedUrl        String?
  /// Opaque per-portal credentials, referenced by key in apps/api config.
  /// Never stored as usable plaintext.
  credentialsRef String?

  /// Portals generally require an agent id on every listing.
  defaultAgentExternalId String?

  settings Json?

  /// Facts behind the status shown in Settings → Portals. Nothing reads as
  /// "connected" until a sync has actually succeeded.
  lastSyncAt    DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  /// Short, credential-free description of the last failure.
  lastError     String?

  listings        PortalListing[]
  syncLogs        PortalSyncLog[]
  mappings        PortalPropertyMapping[]
  publicationRule PortalPublicationRule?
  taxonomy        PortalMapping[]
  feedVersions    PortalFeedVersion[]
  accounts        PortalAccount[]
  syncRuns        PortalSyncRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("portals")
}

model PortalListing {
  id         String   @id @default(cuid())
  portalId   String
  portal     Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  externalId    String?
  externalUrl   String?
  state         PortalSyncState @default(NOT_PUBLISHED)
  lastSyncedAt  DateTime?
  lastError     String?
  /// Normalised error code of the last failure (see PORTAL_ERROR_CODES).
  lastErrorCode String?
  retryCount    Int             @default(0)
  /// Parked after a permanent error or an exhausted retry budget; a person
  /// must fix the cause and republish. Never retried automatically.
  needsReview   Boolean         @default(false)
  /// Earliest time an automatic retry may run (exponential backoff).
  nextRetryAt   DateTime?

  /// Hash of the payload last sent, so an unchanged property is not re-pushed.
  lastPayloadHash String?

  /// Manual operations: which account the listing went through, who did what
  /// last, and the last outcome. A property has one listing per portal, so a
  /// live listing is moved to another account only after it is withdrawn.
  portalAccountId      String?
  portalAccount        PortalAccount?      @relation(fields: [portalAccountId], references: [id], onDelete: SetNull)
  lastAction           PortalRunOperation?
  lastActionAt         DateTime?
  lastActionById       String?
  lastSuccessfulSyncAt DateTime?
  lastFailedAt         DateTime?
  /// Payload as last sent, for debugging. Built from the normalised property
  /// only: it never contains credentials, and media are portal-scoped links.
  payloadSnapshot      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncLogs PortalSyncLog[]

  @@unique([portalId, propertyId])
  @@index([portalAccountId])
  @@index([portalId, state])
  @@index([portalId, needsReview])
  @@index([propertyId])
  @@index([state])
  @@map("portal_listings")
}

model PortalSyncLog {
  id              String         @id @default(cuid())
  portalId        String
  portal          Portal         @relation(fields: [portalId], references: [id], onDelete: Cascade)
  portalListingId String?
  portalListing   PortalListing? @relation(fields: [portalListingId], references: [id], onDelete: SetNull)
  propertyId      String?

  /// The run (one manual operation) this event belongs to, when there is one.
  syncRunId String?
  syncRun   PortalSyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  action     SyncAction
  ok         Boolean
  detail     String?
  errorCode  String?
  durationMs Int?

  actorId   String?
  createdAt DateTime @default(now())

  @@index([portalId, createdAt])
  @@index([portalListingId])
  @@index([syncRunId])
  @@index([ok])
  @@map("portal_sync_logs")
}

/// One connection of the agency to a portal: a portal can have several (for
/// instance a TEST account and a PRODUCTION account). Secrets are never stored
/// here: they are sealed in provider_credentials under scope
/// "portal-account:<id>"; this row keeps only whether each is set, when it was
/// last changed and the last four characters, for the masked display.
model PortalAccount {
  id       String @id @default(cuid())
  portalId String
  portal   Portal @relation(fields: [portalId], references: [id], onDelete: Restrict)

  accountName      String
  agencyExternalId String?
  /// Endpoint override, where a portal needs one. Never contains credentials.
  endpointUrl      String?
  environment      PortalEnvironment   @default(TEST)
  status           PortalAccountStatus @default(CONFIGURED)
  enabled          Boolean             @default(false)

  /// field -> last four characters (only for values long enough to mask safely).
  credentialHints     Json?
  credentialRotatedAt DateTime?

  lastConnectionTestAt     DateTime?
  lastConnectionTestStatus String?
  lastSuccessfulSyncAt     DateTime?
  lastErrorCode            String?
  lastErrorMessage         String?

  /// Non-secret options. `mockMode` is honoured on TEST accounts only.
  settings Json?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings PortalListing[]
  syncRuns PortalSyncRun[]

  @@unique([portalId, accountName, environment])
  @@index([portalId, environment])
  @@map("portal_accounts")
}

/// One manual operation (or, later, one scheduled or bulk pass). The detailed
/// per-listing events stay in portal_sync_logs, linked by syncRunId.
model PortalSyncRun {
  id              String         @id @default(cuid())
  portalId        String
  portal          Portal         @relation(fields: [portalId], references: [id], onDelete: Cascade)
  portalAccountId String?
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id], onDelete: SetNull)
  propertyId      String?

  trigger   PortalRunTrigger   @default(MANUAL)
  operation PortalRunOperation
  status    PortalRunStatus    @default(RUNNING)

  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdById String?
  requestId   String?

  totalListings  Int     @default(0)
  createdCount   Int     @default(0)
  updatedCount   Int     @default(0)
  withdrawnCount Int     @default(0)
  failedCount    Int     @default(0)
  /// Short, credential-free summary of what went wrong.
  errorSummary   String?

  createdAt DateTime @default(now())

  logs PortalSyncLog[]

  @@index([portalId, startedAt])
  @@index([propertyId, startedAt])
  @@index([portalAccountId])
  @@map("portal_sync_runs")
}

/// Correlates our property reference to a portal's own identifier, so a
/// listing deleted on our side can still be removed on theirs.
model PortalPropertyMapping {
  id         String @id @default(cuid())
  portalId   String
  portal     Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  propertyId String

  externalId    String
  externalUrl   String?
  lastConfirmed DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portalId, propertyId])
  @@unique([portalId, externalId])
  @@index([propertyId])
  @@map("portal_property_mappings")
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

/// Every consent decision, granted or withdrawn. The privacy policy states the
/// processor list; this table states what each individual actually agreed to.
model ConsentRecord {
  id String @id @default(cuid())

  /// Hashed subject identifier. Raw email is not stored here.
  subjectHash String
  email       String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String

  /// How the choice was captured.
  source    String
  ipAddress String?
  userAgent String?

  grantedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectHash, purpose])
  @@index([email])
  @@index([purpose, granted])
  @@index([createdAt])
  @@map("consent_records")
}

/// Checked by the mailer before every commercial send. Also populated from
/// hard bounces and spam complaints.
model EmailSuppression {
  id           String            @id @default(cuid())
  email        String
  emailHash    String            @unique
  reason       SuppressionReason
  source       String?
  /// When the original consent was withdrawn, for the 10-business-day record.
  suppressedAt DateTime          @default(now())
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([reason])
  @@map("email_suppressions")
}

/// GDPR / Greek data-subject requests, so requests are auditable rather than
/// handled ad hoc in someone's inbox.
model DataRequest {
  id        String            @id @default(cuid())
  reference String            @unique
  type      DataRequestType
  status    DataRequestStatus @default(OPEN)

  subjectName  String
  subjectEmail String
  subjectHash  String

  /// Which tables were inspected and what was erased.
  findings    Json?
  completedAt DateTime?
  dueAt       DateTime?
  notes       String?

  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subjectEmail])
  @@index([status])
  @@index([dueAt])
  @@map("data_requests")
}

/// DMCA / copyright takedown notices for user-uploaded material.
model DmcaNotice {
  id        String @id @default(cuid())
  reference String @unique

  /// Copyright holder's details, retained as supplied in the notice.
  claimantName    String
  claimantEmail   String
  claimantAddress String?

  originalWorkUrl String?
  workDescription String?

  /// Our material under complaint.
  infringingUrl String?
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  mediaId       String?
  contactId     String?

  goodFaithStatement String?
  signature          String?

  status                DmcaStatus @default(RECEIVED)
  counterNoticeReceived Boolean    @default(false)
  actionTakenAt         DateTime?
  resolvedAt            DateTime?
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([propertyId])
  @@index([createdAt])
  @@map("dmca_notices")
}

/// Append-only. Property and lead history is written here so a status change
/// cannot be made without leaving a record of who did it.
model AuditLog {
  id       String      @id @default(cuid())
  entity   AuditEntity
  entityId String

  action    String
  /// Field-level before/after, with personal fields redacted.
  changes   Json?
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Every outbound message, so "was this person ever emailed" is answerable and
/// an unsubscribe can be honoured against a specific send.
model EmailLog {
  id      String @id @default(cuid())
  toEmail String
  subject String

  /// TRANSACTIONAL is exempt from marketing consent and suppression rules.
  /// MARKETING is never sent without a current grant and a clear suppression list.
  category String

  template          String?
  providerMessageId String?

  /// Set when the recipient used the one-click unsubscribe endpoint.
  unsubscribedAt DateTime?

  consentRecordId String?
  metadata        Json?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toEmail])
  @@index([category])
  @@index([createdAt])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Settings
//
// One typed table per settings area (a single row with id "default"), so a
// column has a real type and a missing value is NULL ("not configured")
// rather than a guess. The catalogue in @home88/domain describes every column:
// labels, validation and which values are secrets.
//
// Secrets never live in these tables. They are AES-256-GCM envelopes in
// provider_credentials, written through the API and never returned by it.
// ---------------------------------------------------------------------------

model CompanySettings {
  id          String   @id @default("default")
  officeName  String?
  legalName   String?
  website     String?
  email       String?
  phone1      String?
  phone2      String?
  mobile      String?
  addressEl   String?
  addressEn   String?
  city        String?
  postalCode  String?
  country     String?
  hoursEl     String?
  hoursEn     String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("company_settings")
}

/// One row per platform (FACEBOOK, INSTAGRAM, …). Legacy platforms such as
/// Google+ may exist from a migration but are never offered for new entries.
model CompanySocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  updatedAt DateTime @updatedAt

  @@map("company_social_links")
}

/// Company profile text, one row per language.
model CompanyProfile {
  id        String   @id @default(cuid())
  locale    String   @unique
  body      String
  updatedAt DateTime @updatedAt

  @@map("company_profiles")
}

model CompanyLegalDetails {
  id                  String   @id @default("default")
  legalNameEl         String?
  legalNameEn         String?
  activityEl          String?
  activityEn          String?
  vatNumber           String?
  taxOffice           String?
  gemiNumber          String?
  kefodeEl            String?
  kefodeEn            String?
  registeredAddressEl String?
  registeredAddressEn String?
  phone               String?
  legalEmail          String?
  updatedAt           DateTime @updatedAt
  updatedById         String?

  @@map("company_legal_details")
}

model CompanyBranding {
  id                 String   @id @default("default")
  logoUrl            String?
  faviconUrl         String?
  colorPrimary       String?
  colorDark          String?
  colorSecondary     String?
  colorBackground    String?
  siteTitle          String?
  siteDescription    String?
  defaultLanguage    String?
  availableLanguages String[] @default([])
  updatedAt          DateTime @updatedAt
  updatedById        String?

  @@map("company_branding")
}

model AppSettings {
  id                     String   @id @default("default")
  listingFooterEl        String?
  listingFooterEn        String?
  uppercaseDescriptions  Boolean?
  uploadMode             String?
  watermarkEnabled       Boolean?
  watermarkPosition      String?
  allowDuplicateContacts Boolean?
  showCustomerNames      String?
  showContactDetails     String?
  propertyRefreshDays    Int?
  requestRefreshDays     Int?
  mapDefaultLat          Float?
  mapDefaultLng          Float?
  showExactLocation      Boolean?
  /// Browser-side Maps key: visible to visitors by design, restricted by domain.
  mapsBrowserKey         String?
  timezone               String?
  currency               String?
  updatedAt              DateTime @updatedAt
  updatedById            String?

  @@map("app_settings")
}

model PropertySettings {
  id                        String   @id @default("default")
  approvalRequired          Boolean?
  minPhotosToPublish        Int?
  requireEnglishDescription Boolean?
  requireEnergyClass        Boolean?
  staleAfterDays            Int?
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("property_settings")
}

model ContactSettings {
  id                   String   @id @default("default")
  duplicateCheckPhone  Boolean?
  duplicateCheckEmail  Boolean?
  duplicateCheckName   Boolean?
  enabledSources       String[] @default([])
  defaultContactMethod String?
  updatedAt            DateTime @updatedAt
  updatedById          String?

  @@map("contact_settings")
}

model RequestSettings {
  id                String   @id @default("default")
  minMatchScore     Int?
  maxMatches        Int?
  priceTolerancePct Int?
  sizeTolerancePct  Int?
  weightArea        Int?
  weightPrice       Int?
  weightSize        Int?
  weightBedrooms    Int?
  weightBathrooms   Int?
  weightFloor       Int?
  weightYear        Int?
  weightFeatures    Int?
  expiryDays        Int?
  newMatchAlerts    String?
  updatedAt         DateTime @updatedAt
  updatedById       String?

  @@map("request_settings")
}

/// Every rate starts NULL: HOME88 supplies its own commission rules.
model CommissionSettings {
  id                      String   @id @default("default")
  saleCommissionPct       Decimal? @db.Decimal(7, 3)
  rentCommissionMonths    Decimal? @db.Decimal(6, 2)
  assignmentCommissionPct Decimal? @db.Decimal(7, 3)
  minimumFee              Decimal? @db.Decimal(12, 2)
  buyerSidePct            Decimal? @db.Decimal(7, 3)
  sellerSidePct           Decimal? @db.Decimal(7, 3)
  agentSharePct           Decimal? @db.Decimal(7, 3)
  agencySharePct          Decimal? @db.Decimal(7, 3)
  vatMode                 String?
  vatRatePct              Decimal? @db.Decimal(7, 3)
  updatedAt               DateTime @updatedAt
  updatedById             String?

  @@map("commission_settings")
}

model CalendarSettings {
  id                        String   @id @default("default")
  timezone                  String?
  workingDays               Int[]    @default([])
  workdayStart              String?
  workdayEnd                String?
  viewingMinutes            Int?
  defaultAppointmentMinutes Int?
  reminderMinutesBefore     Int?
  enabledEventCategories    String[] @default([])
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("calendar_settings")
}

/// Event × channel switches. A missing row means the default (CRM on, email and SMS off).
model NotificationSetting {
  id          String   @id @default(cuid())
  event       String
  channel     String
  enabled     Boolean
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([event, channel])
  @@map("notification_settings")
}

model MandateSettings {
  id                   String   @id @default("default")
  numberingPrefix      String?
  numberingDigits      Int?
  signatureProvider    String?
  signatureLevel       String?
  signatureApiUrl      String?
  signatureAccountId   String?
  signingExpiryDays    Int?
  reminderScheduleDays Int[]    @default([])
  retentionYears       Int?
  /// The longest exclusive term HOME88's counsel has approved, in months. Null
  /// means none is configured, so no maximum is enforced (none is assumed).
  maxExclusiveMonths   Int?
  updatedAt            DateTime @updatedAt
  updatedById          String?

  @@map("mandate_settings")
}

/// One template per mandate type and language. Its wording lives in versions.
model MandateTemplate {
  id        String                   @id @default(cuid())
  type      String
  locale    String
  createdAt DateTime                 @default(now())
  versions  MandateTemplateVersion[]

  @@unique([type, locale])
  @@map("mandate_templates")
}

/// Lawyer-approved wording. A version is editable only while DRAFT; once
/// ACTIVE or RETIRED its body never changes, so a signed mandate always points
/// at the exact text that was signed.
model MandateTemplateVersion {
  id            String          @id @default(cuid())
  templateId    String
  template      MandateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  mandates      Mandate[]
  showings      Showing[]
  version       Int
  status        String          @default("DRAFT")
  body          String
  /// SHA-256 of body, recorded so a stored copy can be verified later.
  checksum      String
  notes         String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  activatedAt   DateTime?
  activatedById String?
  retiredAt     DateTime?

  /// HOME88 for wording written/approved by HOME88's counsel; ESTATE_PLUS_LEGACY
  /// for text carried over from the old system as source material only.
  source                String    @default("HOME88")
  /// Set on legacy text. The database refuses ACTIVE while this is true unless
  /// the legal approval below is recorded against this exact checksum.
  requiresLegalReview   Boolean   @default(false)
  /// Codes from detectLegacyLegalFlags(): what a lawyer must look at.
  legalReviewFlags      String[]  @default([])
  legalApprovedAt       DateTime?
  legalApprovedBy       String?
  legalApprovedChecksum String?

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("mandate_template_versions")
}

model EmailSettings {
  id           String   @id @default("default")
  mode         String?
  apiProvider  String?
  smtpHost     String?
  smtpPort     Int?
  smtpUsername String?
  smtpTls      Boolean?
  fromName     String?
  fromEmail    String?
  replyTo      String?
  disclaimerEl String?
  disclaimerEn String?
  updatedAt    DateTime @updatedAt
  updatedById  String?

  @@map("email_settings")
}

model SmsSettings {
  id          String   @id @default("default")
  provider    String?
  senderName  String?
  accountId   String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("sms_settings")
}

model SecuritySettings {
  id                  String   @id @default("default")
  sessionTimeoutHours Int?
  passwordMinLength   Int?
  maxLoginAttempts    Int?
  lockoutMinutes      Int?
  mfaPolicy           String?
  updatedAt           DateTime @updatedAt
  updatedById         String?

  @@map("security_settings")
}

/// Retention periods have no default: they are set after legal review.
model PrivacySettings {
  id                      String   @id @default("default")
  privacyEmail            String?
  dmcaEmail               String?
  analyticsEnabled        Boolean?
  marketingDoubleOptIn    Boolean?
  leadRetentionMonths     Int?
  contactRetentionMonths  Int?
  emailLogRetentionMonths Int?
  auditRetentionMonths    Int?
  updatedAt               DateTime @updatedAt
  updatedById             String?

  @@map("privacy_settings")
}

model SubscriptionSettings {
  id          String    @id @default("default")
  plan        String?
  status      String?
  startsAt    DateTime? @db.Date
  expiresAt   DateTime? @db.Date
  renewal     String?
  updatedAt   DateTime  @updatedAt
  updatedById String?

  @@map("subscription_settings")
}

/// Write-only provider secrets: AES-256-GCM, bound to (scope, field) as
/// associated data so an envelope cannot be moved to another field. The key
/// is SETTINGS_ENCRYPTION_KEY in the server environment; keyId records which
/// key wrote the envelope.
model ProviderCredential {
  id          String   @id @default(cuid())
  scope       String
  field       String
  ciphertext  String
  iv          String
  authTag     String
  keyId       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([scope, field])
  @@map("provider_credentials")
}

/// Who changed which setting, when. Secrets and sensitive identifiers are
/// recorded as "changed — value masked" with no old or new value, ever.
model SettingsAuditLog {
  id        String   @id @default(cuid())
  section   String
  field     String?
  action    String
  oldValue  Json?
  newValue  Json?
  masked    Boolean  @default(false)
  summary   String?
  actorId   String?
  actorName String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([section, createdAt])
  @@index([createdAt])
  @@map("settings_audit_log")
}

/// Overrides of the default settings grants per role. SUPER_ADMIN always
/// holds everything and is never stored here.
model RolePermission {
  id          String   @id @default(cuid())
  role        UserRole
  permission  String
  granted     Boolean
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([role, permission])
  @@map("role_permissions")
}

/// Internal property tags with stable codes (replacing Estate+ free-text
/// categories). Never shown on the public website.
model PropertyTag {
  id           String   @id @default(cuid())
  code         String   @unique
  labelEl      String
  labelEn      String?
  color        String   @default("slate")
  active       Boolean  @default(true)
  isSystem     Boolean  @default(false)
  /// Estate+ category names that map to this tag, for the data migration.
  legacyLabels String[] @default([])
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments PropertyTagAssignment[]

  @@map("property_tags")
}

/// Which internal tags a property carries. Tag codes are stable, so portal
/// publication rules (and the DO_NOT_PUBLISH flag) match on them rather than on
/// free-text notes.
model PropertyTagAssignment {
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tagId       String
  tag         PropertyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime    @default(now())

  @@id([propertyId, tagId])
  @@index([tagId])
  @@map("property_tag_assignments")
}

/// Region › City › Area › Neighbourhood.
model Area {
  id                 String                @id @default(cuid())
  level              String
  parentId           String?
  parent             Area?                 @relation("AreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           Area[]                @relation("AreaTree")
  nameEl             String
  nameEn             String?
  slug               String                @unique
  active             Boolean               @default(true)
  sortOrder          Int                   @default(0)
  mappings           AreaExternalMapping[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  marketObservations MarketObservation[]

  @@index([parentId])
  @@index([level])
  @@map("areas")
}

/// A portal's own id for an area (e.g. Spitogatos area id), so portal ids are
/// never hard-coded in property code.
model AreaExternalMapping {
  id         String   @id @default(cuid())
  areaId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  portalCode String
  externalId String
  updatedAt  DateTime @updatedAt

  @@unique([areaId, portalCode])
  @@index([portalCode, externalId])
  @@map("area_external_mappings")
}

model PortalPublicationRule {
  id            String   @id @default(cuid())
  portalId      String   @unique
  portal        Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  mode          String   @default("NONE")
  propertyTypes String[] @default([])
  includeTags   String[] @default([])
  excludeTags   String[] @default([])
  /// Optional narrowing on top of `mode` (listing types, cities, price and area
  /// bounds, required tags). Parsed defensively by @home88/portals.
  conditions    Json?
  updatedAt     DateTime @updatedAt
  updatedById   String?

  @@map("portal_publication_rules")
}

enum PortalMappingKind {
  TYPE
  FEATURE
}

enum PortalMappingStatus {
  MAPPED
  UNSUPPORTED
  TRANSFORM
}

/// How one portal names a HOME88 property type or feature. Kept as data so no
/// portal's vocabulary is hard-coded in property code. Locations are mapped by
/// AreaExternalMapping.
model PortalMapping {
  id            String              @id @default(cuid())
  portalId      String
  portal        Portal              @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind          PortalMappingKind
  internalCode  String
  status        PortalMappingStatus @default(MAPPED)
  externalValue String?
  updatedById   String?
  updatedAt     DateTime            @updatedAt

  @@unique([portalId, kind, internalCode])
  @@map("portal_mappings")
}

/// One row per distinct feed we generated for a portal. A feed whose size
/// collapsed against the last confirmed one is recorded as blocked and is not
/// served until a manager approves it.
model PortalFeedVersion {
  id            String    @id @default(cuid())
  portalId      String
  portal        Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  version       Int
  schemaVersion String
  propertyCount Int
  checksum      String
  generatedAt   DateTime  @default(now())
  blocked       Boolean   @default(false)
  blockReason   String?
  approvedAt    DateTime?
  approvedById  String?

  @@unique([portalId, version])
  @@index([portalId, generatedAt])
  @@map("portal_feed_versions")
}

// ---------------------------------------------------------------------------
// Public intake
//
// Everything a visitor sends from the website lands here, then in the CRM for
// review. A submission is NOT a property: nothing becomes inventory until an
// agent converts or links it.
// ---------------------------------------------------------------------------

enum LeadType {
  GENERAL_INQUIRY
  SELLER_OWNER
  SELLER_VALUATION
  BUYER
  PROPERTY_ENQUIRY
  BUYER_VIEWING
}

enum SubmissionKind {
  ASSIGNMENT
  VALUATION
}

enum SubmissionStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  VALUATION
  ASSIGNMENT
  PROPERTY_CREATED
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum MediaLifecycle {
  UPLOADING
  PROCESSING
  AVAILABLE
  QUARANTINED
  REJECTED
  DELETED
}

enum MediaSource {
  AGENT_UPLOAD
  OWNER_SUBMISSION
  IMPORT
  PORTAL
  MIGRATION
  OTHER
}

enum ViewingRequestStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

/// An owner's offer of a property (assignment) or request for a valuation.
model PropertySubmission {
  id        String @id @default(cuid())
  /// Customer-facing code, e.g. SUB-2026-000123. Never the database id.
  reference String @unique

  kind   SubmissionKind   @default(ASSIGNMENT)
  status SubmissionStatus @default(NEW)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  titleEl       String
  descriptionEl String
  listingType   ListingType
  propertyType  PropertyType
  price         Decimal?     @db.Decimal(14, 2)
  area          Decimal?     @db.Decimal(10, 2)
  bedrooms      Int?
  city          String?
  neighborhood  String?

  assignedToId String?
  assignedTo   User?   @relation("SubmissionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Set when an agent creates a property from it, or links an existing one.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  reviewNotes        String?
  rejectedReason     String?
  /// Unconverted submissions are not kept forever; the period is configuration.
  retentionExpiresAt DateTime?

  media     PropertyMedia[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contactId])
  @@index([assignedToId, status])
  @@map("property_submissions")
}

/// A visitor's request for a viewing. It is a request until an agent confirms
/// it, at which point a `Viewing` is created and linked.
model ViewingRequest {
  id        String @id @default(cuid())
  reference String @unique

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  preferredStart DateTime?
  note           String?
  status         ViewingRequestStatus @default(REQUESTED)
  /// The scheduled viewing, once an agent confirms.
  viewingId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([propertyId])
  @@map("viewing_requests")
}

/// One row per accepted public submission, keyed by the browser's idempotency
/// key, so a retried POST returns the original reference instead of creating a
/// second contact, lead or submission.
model IntakeReceipt {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  flow           String
  reference      String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("intake_receipts")
}

/// Quota ledger for anonymous uploads. The token's hash is stored, never the
/// token; `prefix` is the random segment of the quarantine storage keys.
model IntakeUploadSession {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  prefix        String   @unique
  photoCount    Int      @default(0)
  documentCount Int      @default(0)
  byteTotal     BigInt   @default(0)
  expiresAt     DateTime
  /// Set when the submission that claimed these uploads was created.
  submissionId  String?
  createdAt     DateTime @default(now())

  @@index([expiresAt])
  @@map("intake_upload_sessions")
}

/// In-app notice for staff. `userId` null means every manager.
model CrmNotification {
  id         String    @id @default(cuid())
  kind       String
  title      String
  entityType String
  entityId   String
  userId     String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("crm_notifications")
}

// Transactions (Συναλλαγές)
//
// The commercial record of a sale or rental, from the first offer to closing:
// negotiation rounds (offers), status, agreed price, documents checklist,
// commission and an append-only timeline. A transaction is never deleted;
// it ends CLOSED or CANCELLED.
// ---------------------------------------------------------------------------

model Transaction {
  id        String @id @default(cuid())
  /// Public code, e.g. TRX-000001.
  reference String @unique

  /// SALE or RENT.
  type   String
  /// NEGOTIATION → AGREEMENT → CONTRACT → CLOSED, or CANCELLED.
  status String @default("NEGOTIATION")

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  buyerContactId  String?
  buyerContact    Contact? @relation("TransactionBuyer", fields: [buyerContactId], references: [id], onDelete: SetNull)
  sellerContactId String?
  sellerContact   Contact? @relation("TransactionSeller", fields: [sellerContactId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Snapshot of the buyer/tenant, kept even if the contact is later erased.
  buyerName  String
  buyerPhone String?
  buyerEmail String?

  agentId String?
  agent   User?   @relation("TransactionAgent", fields: [agentId], references: [id], onDelete: SetNull)

  /// Agreed price (SALE) or monthly rent (RENT), set when an offer is accepted.
  agreedAmount    Decimal?  @db.Decimal(14, 2)
  acceptedOfferId String?   @unique
  agreementAt     DateTime?
  contractAt      DateTime?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?

  offers     Offer[]
  events     TransactionEvent[]
  commission TransactionCommission?
  checklist  TransactionChecklistItem[]
  documents  Document[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([propertyId])
  @@index([agentId, status])
  @@index([createdAt])
  @@map("transactions")
}

/// Timeline. Append-only: the database refuses updates and deletes.
model TransactionEvent {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  type          String
  summary       String
  data          Json?
  actorId       String?
  actorName     String?
  createdAt     DateTime    @default(now())

  @@index([transactionId, createdAt])
  @@map("transaction_events")
}

/// The commission for one transaction, calculated from Settings and stored as
/// a snapshot (rules used included), so a later change of rates never
/// silently rewrites an agreed commission.
model TransactionCommission {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  basis          String
  rate           Decimal @db.Decimal(9, 4)
  baseAmount     Decimal @db.Decimal(14, 2)
  buyerSide      Decimal @db.Decimal(14, 2)
  sellerSide     Decimal @db.Decimal(14, 2)
  net            Decimal @db.Decimal(14, 2)
  vat            Decimal @db.Decimal(14, 2)
  gross          Decimal @db.Decimal(14, 2)
  agentShare     Decimal @db.Decimal(14, 2)
  agencyShare    Decimal @db.Decimal(14, 2)
  minimumApplied Boolean @default(false)

  /// Rules from Settings at the time of calculation.
  rulesSnapshot  Json
  overridden     Boolean @default(false)
  overrideReason String?

  /// EXPECTED, INVOICED, PARTIALLY_PAID, PAID, CANCELLED (OVERDUE is derived).
  status        String    @default("EXPECTED")
  invoiceNumber String?
  dueDate       DateTime? @db.Date
  paidAmount    Decimal   @default(0) @db.Decimal(14, 2)
  paidAt        DateTime?

  calculatedById String?
  calculatedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@map("transaction_commissions")
}

/// What documents a transaction needs and where each stands. Items are added
/// per transaction: which documents apply is a business and legal decision,
/// not a built-in list.
model TransactionChecklistItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  label         String
  status        String      @default("REQUESTED")
  note          String?
  documentId    String?
  document      Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sortOrder     Int         @default(0)
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([transactionId])
  @@map("transaction_checklist_items")
}

// ---------------------------------------------------------------------------
// Seller / owner pipeline and valuations (Phase 3)
// ---------------------------------------------------------------------------

/// An owner who may list with HOME88, from first contact to a listed property.
model SellerLead {
  id        String @id @default(cuid())
  /// Public code, e.g. SEL-000001.
  reference String @unique

  /// NEW → CONTACTED → VALUATION → PROPOSAL → MANDATE → LISTED, or LOST.
  stage       String @default("NEW")
  /// SALE or RENT.
  listingType String

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Snapshot of the owner's name, kept even if the contact is later erased.
  ownerName String

  /// Set once the property exists in the CRM; required to mark LISTED.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// What the owner described, before a property record exists.
  propertyType String?
  city         String?
  areaName     String?
  address      String?
  area         Decimal? @db.Decimal(10, 2)
  bedrooms     Int?
  floor        Int?
  yearBuilt    Int?
  condition    String?

  /// The owner's own price expectation.
  askingPrice Decimal? @db.Decimal(14, 2)
  motivation  String?
  timeframe   String?
  source      String?

  agentId String?
  agent   User?   @relation("SellerLeadAgent", fields: [agentId], references: [id], onDelete: SetNull)

  nextFollowUpAt DateTime?
  listedAt       DateTime?
  lostAt         DateTime?
  lostReason     String?
  notes          String?

  events     SellerLeadEvent[]
  valuations Valuation[]
  mandates   Mandate[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([stage])
  @@index([agentId, stage])
  @@index([contactId])
  @@index([propertyId])
  @@index([nextFollowUpAt])
  @@map("seller_leads")
}

/// Timeline. Append-only: the database refuses updates and deletes.
model SellerLeadEvent {
  id           String     @id @default(cuid())
  sellerLeadId String
  sellerLead   SellerLead @relation(fields: [sellerLeadId], references: [id], onDelete: Restrict)
  type         String
  summary      String
  data         Json?
  actorId      String?
  actorName    String?
  createdAt    DateTime   @default(now())

  @@index([sellerLeadId, createdAt])
  @@map("seller_lead_events")
}

/// Comparative market valuation. A FINAL valuation is frozen by the database.
model Valuation {
  id        String @id @default(cuid())
  /// Public code, e.g. VAL-000001.
  reference String @unique

  /// DRAFT or FINAL.
  status      String @default("DRAFT")
  /// SALE (price) or RENT (monthly rent).
  listingType String

  propertyId   String?
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sellerLeadId String?
  sellerLead   SellerLead? @relation(fields: [sellerLeadId], references: [id], onDelete: SetNull)

  /// The subject as valued (a snapshot, so later edits do not rewrite it).
  propertyType String
  city         String?
  areaName     String?
  area         Decimal? @db.Decimal(10, 2)
  bedrooms     Int?
  floor        Int?
  yearBuilt    Int?
  condition    String?

  /// Result of the last calculation over the included comparables.
  compCount    Int      @default(0)
  medianPerSqm Decimal? @db.Decimal(12, 2)
  lowPerSqm    Decimal? @db.Decimal(12, 2)
  highPerSqm   Decimal? @db.Decimal(12, 2)
  estimate     Decimal? @db.Decimal(14, 2)
  low          Decimal? @db.Decimal(14, 2)
  high         Decimal? @db.Decimal(14, 2)
  confidence   String?

  /// The agent's recommendation and reasoning, set when finalising.
  recommendedPrice Decimal? @db.Decimal(14, 2)
  rationale        String?

  agentId String?
  agent   User?   @relation("ValuationAgent", fields: [agentId], references: [id], onDelete: SetNull)

  comparables ValuationComparable[]

  finalizedAt    DateTime?
  finalizedById  String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sourceRequests ValuationRequest[]

  @@index([propertyId])
  @@index([sellerLeadId])
  @@index([agentId, status])
  @@index([createdAt])
  @@map("valuations")
}

model ValuationComparable {
  id          String    @id @default(cuid())
  valuationId String
  valuation   Valuation @relation(fields: [valuationId], references: [id], onDelete: Restrict)

  /// SOLD, RENTED, ASKING or EXTERNAL.
  kind       String
  /// Internal comparable: the property it came from.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  /// Property reference or the agent's label for an external comparable.
  label      String
  /// Where an external comparable came from (portal, registry, colleague…).
  source     String?

  city       String?
  areaName   String?
  price      Decimal   @db.Decimal(14, 2)
  area       Decimal   @db.Decimal(10, 2)
  bedrooms   Int?
  floor      Int?
  yearBuilt  Int?
  condition  String?
  /// Sale/lease date for SOLD/RENTED, listing date for ASKING.
  observedAt DateTime?
  similarity Int?

  adjustmentPct    Decimal @default(0) @db.Decimal(6, 2)
  adjustmentReason String?
  included         Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([valuationId])
  @@map("valuation_comparables")
}

// ---------------------------------------------------------------------------
// Digital mandates (Phase 4)
// ---------------------------------------------------------------------------

/// A mandate built from the lawyer-approved template version active at the
/// time. Once issued, its text, terms and PDF are frozen by the database.
model Mandate {
  id        String  @id @default(cuid())
  /// Internal code, e.g. MND-000001.
  reference String  @unique
  /// Official number from Settings → Ψηφιακές Εντολές, allocated on issue.
  number    String? @unique

  /// VIEWING, SIMPLE_ASSIGNMENT or EXCLUSIVE_ASSIGNMENT.
  type   String
  locale String @default("el")
  /// DRAFT → ISSUED → SENT → VIEWED → SIGNED, or DECLINED / EXPIRED / CANCELLED.
  status String @default("DRAFT")

  propertyId   String?
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sellerLeadId String?
  sellerLead   SellerLead? @relation(fields: [sellerLeadId], references: [id], onDelete: SetNull)

  startsAt DateTime?
  endsAt   DateTime?
  /// Agreed values entered by the agent. Only custom clauses, imported legacy
  /// data and template presentation settings belong here: anything that is
  /// searched, validated, calculated or printed as a legal term has a column.
  terms    Json      @default("{}")

  // --- Structured fee (same columns as Showing) ---------------------------
  feePayer                 FeePayer?
  feeMethod                FeeMethod?
  feeBasis                 FeeBasis?
  feePercentage            Decimal?        @db.Decimal(7, 4)
  feeFixedAmount           Decimal?        @db.Decimal(14, 2)
  feeCurrency              String?
  vatTreatment             VatTreatment?
  vatRate                  Decimal?        @db.Decimal(5, 2)
  paymentTrigger           PaymentTrigger?
  /// Set (with a reason) when the owner/agent accepted a COMMISSION_ANOMALY warning.
  feeAnomalyOverrideReason String?
  feeAnomalyOverriddenById String?

  // --- Structured terms ----------------------------------------------------
  durationType                DurationType?
  /// null = not answered yet; the validator blocks issuance until it is.
  knownDefects                Boolean?
  defectsDisclosureConfirmed  Boolean?
  defectsDescription          String?
  photoPermission             Boolean?
  videoPermission             Boolean?
  floorplanPermission         Boolean?
  signboardPermission         Boolean?
  portalPublicationPermission Boolean?
  socialMediaPermission       Boolean?
  cooperatingBrokerPermission Boolean?
  brokerCooperationAllowed    Boolean?
  dualRepresentationConsent   Boolean?
  marketingChannels           String[]      @default([])
  specialTerms                String?

  /// A mandate this one replaces. Only affects conflict detection, never rewrites history.
  supersedesMandateId String?
  supersedes          Mandate?  @relation("MandateSupersedes", fields: [supersedesMandateId], references: [id], onDelete: SetNull)
  supersededBy        Mandate[] @relation("MandateSupersedes")

  /// Last validateMandate() result, so a screen can show what is still missing.
  completenessResult    Json?
  completenessCheckedAt DateTime?

  /// Everything the issued document was rendered from (encrypted: it holds
  /// personal data). Set when issued through the document pipeline.
  issuanceSnapshotEncrypted String?
  issuanceSnapshotChecksum  String?
  storageState              DocumentStorageState @default(NOT_STORED)
  verificationCode          String?              @unique

  extensions        MandateExtension[]
  milestones        PaymentMilestone[]
  conflictOverrides MandateConflictOverride[]

  templateVersionId     String?
  templateVersion       MandateTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  templateChecksum      String?
  /// The filled-in text. Contains personal data, so it is stored encrypted.
  renderedTextEncrypted String?
  /// SHA-256 of the filled-in text, to verify a copy later.
  renderedChecksum      String?

  pdfDocumentId    String?   @unique
  pdfDocument      Document? @relation("MandatePdf", fields: [pdfDocumentId], references: [id], onDelete: Restrict)
  pdfChecksum      String?
  signedDocumentId String?   @unique
  signedDocument   Document? @relation("MandateSignedCopy", fields: [signedDocumentId], references: [id], onDelete: Restrict)
  signedChecksum   String?

  /// PROVIDER (e-signature) or PAPER (signed copy uploaded).
  signatureMethod   String?
  signatureProvider String?
  signatureLevel    String?
  envelopeId        String?   @unique
  signingExpiresAt  DateTime?

  issuedAt     DateTime?
  sentAt       DateTime?
  viewedAt     DateTime?
  signedAt     DateTime?
  declinedAt   DateTime?
  expiredAt    DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  agentId String?
  agent   User?   @relation("MandateAgent", fields: [agentId], references: [id], onDelete: SetNull)

  parties MandateParty[]
  events  MandateEvent[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([propertyId, type, status])
  @@index([sellerLeadId])
  @@index([agentId, status])
  @@index([createdAt])
  @@index([supersedesMandateId])
  @@map("mandates")
}

/// Who signs: the owner(s) of an assignment, the client of a viewing mandate.
/// Identity details are personal data and stored encrypted.
model MandateParty {
  id        String   @id @default(cuid())
  mandateId String
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  /// OWNER or CLIENT.
  role      String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  fullName  String

  taxIdEncrypted    String?
  idNumberEncrypted String?
  addressEncrypted  String?
  emailEncrypted    String?
  phoneEncrypted    String?

  sortOrder Int       @default(0)
  signedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([mandateId])
  @@index([contactId])
  @@map("mandate_parties")
}

/// Timeline. Append-only: the database refuses updates and deletes.
model MandateEvent {
  id        String   @id @default(cuid())
  mandateId String
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  type      String
  summary   String
  data      Json?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([mandateId, createdAt])
  @@map("mandate_events")
}

// ---------------------------------------------------------------------------
// Client communications (Phase 5)
// ---------------------------------------------------------------------------

/// A message template written by HOME88 (the system ships none).
model MessageTemplate {
  id      String  @id @default(cuid())
  name    String
  /// EMAIL or SMS.
  channel String
  /// SERVICE or MARKETING.
  purpose String  @default("SERVICE")
  locale  String  @default("el")
  subject String?
  body    String
  active  Boolean @default(true)

  messages Message[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channel, active])
  @@map("message_templates")
}

/// Every email or SMS sent to a client from the CRM, including the ones the
/// rules blocked. Address and body are personal data and stored encrypted.
model Message {
  id      String @id @default(cuid())
  /// EMAIL or SMS.
  channel String
  /// SERVICE or MARKETING.
  purpose String
  /// SENT, LOGGED (no provider), FAILED or BLOCKED.
  status  String

  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  /// Optional context the message was sent from.
  leadId        String?
  transactionId String?
  sellerLeadId  String?
  viewingId     String?

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  toEncrypted       String?
  subject           String?
  bodyEncrypted     String?
  segments          Int?
  emailLogId        String?
  providerMessageId String?
  error             String?

  sentById  String?
  sentBy    User?     @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([contactId, createdAt])
  @@index([propertyId])
  @@index([status, createdAt])
  @@index([providerMessageId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Automation and AI assistance
// ---------------------------------------------------------------------------

/// Days after which an automation fires. Every column is empty (rule off)
/// until HOME88 sets it; the platform ships no thresholds.
model AutomationSettings {
  id                        String   @id @default("default")
  leadStaleDays             Int?
  viewingFollowUpDays       Int?
  mandateExpiryDays         Int?
  offerExpiryDays           Int?
  sellerFollowUpOverdueDays Int?
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("automation_settings")
}

/// One firing of an automation. (rule, entity, episode) is unique, so the same
/// condition on the same record never creates a second task. Append-only.
model AutomationRun {
  id           String   @id @default(cuid())
  rule         String
  entityType   String
  entityId     String
  /// Identifies one occurrence of the condition (e.g. the last-contact time it started from).
  episode      String
  taskId       String?
  assignedToId String?
  createdAt    DateTime @default(now())

  @@unique([rule, entityId, episode])
  @@index([createdAt])
  @@index([rule, createdAt])
  @@map("automation_runs")
}

/// Whether AI assistance is on, with which provider and model, and for which
/// uses. Everything is off until an administrator turns it on. The API key is
/// an encrypted write-only secret (provider_credentials, scope "ai").
model AiSettings {
  id                   String   @id @default("default")
  provider             String?
  model                String?
  enabled              Boolean?
  allowDescriptions    Boolean?
  allowReportSummaries Boolean?
  hourlyLimitPerUser   Int?
  updatedAt            DateTime @updatedAt
  updatedById          String?

  @@map("ai_settings")
}

/// Who used an AI feature, when, and what it cost in tokens. Never the prompt
/// or the answer. Append-only.
model AiRequest {
  id           String   @id @default(cuid())
  feature      String
  userId       String?
  user         User?    @relation("AiRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  status       String
  inputTokens  Int?
  outputTokens Int?
  error        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_requests")
}

// ---------------------------------------------------------------------------
// Market data and automated valuation (V1)
// ---------------------------------------------------------------------------

/// Where market numbers may come from, and what each source's licence allows.
/// A source is read by the valuation engine only when it is active AND marked
/// usable for valuation; licence flags stay null until confirmed.
model MarketDataSource {
  id                  String              @id @default(cuid())
  /// HOME88, MAMA, BANK_OF_GREECE, ELSTAT, OBJECTIVE_VALUES, a licensed feed...
  code                String              @unique
  name                String
  /// INTERNAL, OFFICIAL_PUBLIC or LICENSED.
  sourceType          String
  /// What it provides: TRANSACTION, ASKING, INDEX, OBJECTIVE_VALUE, GEOGRAPHY.
  dataKinds           String[]            @default([])
  /// FILE, API, FEED or INTERNAL.
  accessMethod        String?
  endpoint            String?
  updateFrequency     String?
  licenseType         String?
  licenseTermsUrl     String?
  termsVersion        String?
  permittedUse        String?
  commercialUse       Boolean?
  retentionAllowed    Boolean?
  derivativeAnalytics Boolean?
  redistribution      Boolean?
  active              Boolean             @default(false)
  usableForValuation  Boolean             @default(false)
  notes               String?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  observations        MarketObservation[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("market_data_sources")
}

/// One observed price from one source, with full provenance. Asking prices and
/// recorded transactions are different things and are never mixed up:
/// `observationType` says which one this is.
model MarketObservation {
  id                String           @id @default(cuid())
  sourceId          String
  source            MarketDataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  /// The record's id in its source, so a re-import updates instead of duplicating.
  sourceRecordId    String
  /// TRANSACTION, ASKING, BANK_VALUATION, OBJECTIVE_VALUE or RENT_ASKING.
  observationType   String
  propertyType      String?
  listingType       String?
  region            String?
  municipality      String?
  city              String?
  areaName          String?
  /// Canonical area once the source name has been mapped.
  areaId            String?
  area              Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  areaSqm           Decimal?         @db.Decimal(10, 2)
  landAreaSqm       Decimal?         @db.Decimal(12, 2)
  bedrooms          Int?
  bathrooms         Int?
  floor             Int?
  totalFloors       Int?
  yearBuilt         Int?
  yearRenovated     Int?
  condition         String?
  features          Json?
  price             Decimal          @db.Decimal(14, 2)
  pricePerSqm       Decimal?         @db.Decimal(12, 2)
  /// Contract date for a transaction, listing/observation date otherwise.
  observedAt        DateTime
  firstSeenAt       DateTime?
  lastSeenAt        DateTime?
  /// 0–100: source quality × completeness × location confidence.
  quality           Int?
  rawPayload        Json
  normalizedPayload Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([sourceId, sourceRecordId])
  @@index([observationType, propertyType, observedAt])
  @@index([city, areaName])
  @@index([areaId])
  @@map("market_observations")
}

/// A valuation requested on the website (or later from the CRM), with the
/// automated result exactly as produced. Never rewritten: an agent's own view
/// lives in a linked agent valuation (`valuations`).
model ValuationRequest {
  id                    String                       @id @default(cuid())
  /// Public code, e.g. EKT-000001.
  reference             String                       @unique
  /// COMPLETED or INSUFFICIENT_DATA (the engine outcome; never changes).
  status                String
  /// Workflow: NEW, REVIEWING, CONTACTED, INSPECTION_REQUIRED, COMPLETED, CONVERTED, CLOSED.
  stage                 String                       @default("NEW")
  channel               String                       @default("WEBSITE")
  listingType           String                       @default("SALE")
  propertyType          String
  region                String?
  city                  String?
  areaName              String?
  areaSqm               Decimal                      @db.Decimal(10, 2)
  bedrooms              Int?
  bathrooms             Int?
  floor                 Int?
  totalFloors           Int?
  yearBuilt             Int?
  condition             String?
  features              Json                         @default("{}")
  estimatedMin          Decimal?                     @db.Decimal(14, 2)
  estimatedValue        Decimal?                     @db.Decimal(14, 2)
  estimatedMax          Decimal?                     @db.Decimal(14, 2)
  pricePerSqm           Decimal?                     @db.Decimal(12, 2)
  pricePerSqmLow        Decimal?                     @db.Decimal(12, 2)
  pricePerSqmHigh       Decimal?                     @db.Decimal(12, 2)
  confidence            String?
  comparableCount       Int                          @default(0)
  strongComparableCount Int                          @default(0)
  transactionCount      Int                          @default(0)
  askingCount           Int                          @default(0)
  /// AREA, CITY or REGION: how far the comparable search had to widen.
  scope                 String?
  /// Explanation (confidence reasons, tier counts, outliers, size range).
  explanation           Json                         @default("{}")
  engineVersion         String
  methodologyVersion    String
  /// The engine configuration used, so the result can be reproduced.
  config                Json
  referenceDate         DateTime
  /// Hash of the submitted data for de-duplicating double submits.
  idempotencyKey        String?                      @unique
  contactId             String?
  contact               Contact?                     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId                String?
  lead                  Lead?                        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  valuationId           String?
  valuation             Valuation?                   @relation(fields: [valuationId], references: [id], onDelete: SetNull)
  assignedAgentId       String?
  assignedAgent         User?                        @relation("ValuationRequestAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  comparables           ValuationRequestComparable[]
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([stage, createdAt])
  @@index([status])
  @@index([leadId])
  @@index([createdAt])
  @@map("valuation_requests")
}

/// A comparable exactly as the engine used it (frozen copy, not a live link).
model ValuationRequestComparable {
  id              String           @id @default(cuid())
  requestId       String
  request         ValuationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// e.g. property:<id>, transaction:<id>, observation:<id>.
  observationRef  String
  propertyId      String?
  property        Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  source          String
  observationType String
  tier            String
  price           Decimal          @db.Decimal(14, 2)
  areaSqm         Decimal          @db.Decimal(10, 2)
  pricePerSqm     Decimal          @db.Decimal(12, 2)
  similarity      Decimal          @db.Decimal(5, 3)
  recency         Decimal          @db.Decimal(5, 3)
  weight          Decimal          @db.Decimal(8, 5)
  ageMonths       Decimal          @db.Decimal(6, 1)
  breakdown       Json
  outlier         Boolean          @default(false)
  rank            Int
  snapshot        Json
  createdAt       DateTime         @default(now())

  @@index([requestId])
  @@index([propertyId])
  @@map("valuation_request_comparables")
}

// ---------------------------------------------------------------------------
// Brokerage documents: showings (Υπόδειξη), owners, extensions, legacy mapping
// (Phase A: data model and rules only; rendering, screens and import are later)
// ---------------------------------------------------------------------------

enum ShowingStatus {
  DRAFT
  READY_FOR_ISSUANCE
  ISSUED
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ShowingPartyRole {
  BUYER
  TENANT
  JOINT_BUYER
  SPOUSE
  COMPANY_REPRESENTATIVE
  ATTORNEY_IN_FACT
  AUTHORIZED_REPRESENTATIVE
  OTHER
}

enum FeePayer {
  OWNER
  BUYER
  TENANT
  LANDLORD
  BOTH_PARTIES
  OTHER
}

enum FeeMethod {
  PERCENTAGE
  FIXED_AMOUNT
  CUSTOM
  NEGOTIATED_LATER
}

enum FeeBasis {
  ASKING_PRICE
  FINAL_SALE_PRICE
  MONTHLY_RENT
  ANNUAL_RENT
  CONTRACT_VALUE
  OTHER
}

enum VatTreatment {
  PLUS_VAT
  VAT_INCLUDED
  VAT_EXEMPT
  NOT_APPLICABLE
}

enum PaymentTrigger {
  RESERVATION
  PRELIMINARY_AGREEMENT
  FINAL_CONTRACT
  LEASE_SIGNING
  INSTALLMENTS
  CUSTOM
}

enum DurationType {
  INDEFINITE
  FIXED_TERM
}

enum OwnerCapacity {
  OWNER
  CO_OWNER
  USUFRUCTUARY
  BARE_OWNER
  LEGAL_REPRESENTATIVE
  ATTORNEY_IN_FACT
  COMPANY_REPRESENTATIVE
  OTHER
}

enum MandateExtensionStatus {
  DRAFT
  ISSUED
  SIGNED
  CANCELLED
}

enum LegacySourceSystem {
  ESTATE_PLUS
  HOME88_LEGACY
  MANUAL_IMPORT
  CSV_IMPORT
}

/// The legal record of an introduction of one or more properties to a client
/// (Υπόδειξη Ακινήτου). The appointment itself is a Viewing; this is the
/// document, with its own number, lifecycle and frozen snapshots.
model Showing {
  id       String        @id @default(cuid())
  /// ΥΠ-YYYY-NNNNNN, allocated when the showing is issued; never reused.
  number   String?       @unique
  year     Int?
  status   ShowingStatus @default(DRAFT)
  /// Language of the document; a template must exist for it.
  language String        @default("el")

  contactId         String?
  contact           Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  responsibleUserId String?
  responsibleUser   User?    @relation("ShowingResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  /// The appointment this document came from (optional) and the appointments it led to.
  sourceViewingId String?
  sourceViewing   Viewing?  @relation("ShowingSourceViewing", fields: [sourceViewingId], references: [id], onDelete: SetNull)
  viewings        Viewing[] @relation("ShowingViewings")

  documentDate DateTime? @db.Date
  /// When the client is (or was) shown the properties; the date and time of the showing.
  visitAt      DateTime?
  issuedAt     DateTime?
  sentAt       DateTime?
  viewedAt     DateTime?
  signedAt     DateTime?
  declinedAt   DateTime?
  expiresAt    DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // --- Structured fee (same columns as Mandate) ----------------------------
  feePayer                  FeePayer?
  feeMethod                 FeeMethod?
  feeBasis                  FeeBasis?
  feePercentage             Decimal?        @db.Decimal(7, 4)
  feeFixedAmount            Decimal?        @db.Decimal(14, 2)
  feeCurrency               String?
  vatTreatment              VatTreatment?
  vatRate                   Decimal?        @db.Decimal(5, 2)
  paymentTrigger            PaymentTrigger?
  feeAnomalyOverrideReason  String?
  feeAnomalyOverriddenById  String?
  /// Consent to HOME88 acting for the counterparty too, where the template asks for it.
  dualRepresentationConsent Boolean?
  comments                  String?

  /// The client as printed. Holds identity details, so it is stored encrypted.
  clientSnapshotEncrypted String?
  /// Company details as printed (not personal data).
  companySnapshot         Json?

  templateVersionId    String?
  templateVersion      MandateTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  templateChecksum     String?
  renderedTextChecksum String?
  pdfStorageKey        String?
  pdfChecksum          String?
  signedPdfStorageKey  String?
  signedPdfChecksum    String?

  /// The text as issued (it holds personal data, so encrypted) and everything it was
  /// rendered from. The PDF can be reproduced from this snapshot alone.
  renderedTextEncrypted     String?
  issuanceSnapshotEncrypted String?
  issuanceSnapshotChecksum  String?
  /// NOT_STORED until issued; PENDING while the PDF is not yet verified at its final key.
  storageState              DocumentStorageState @default(NOT_STORED)
  /// Public reference for the verification endpoint; reveals nothing by itself.
  verificationCode          String?              @unique

  /// The showing this one corrects. The original is cancelled (or, if already
  /// signed, left as it is) when the replacement is issued.
  replacesShowingId String?  @unique
  replaces          Showing? @relation("ShowingReplacement", fields: [replacesShowingId], references: [id], onDelete: SetNull)
  replacedBy        Showing? @relation("ShowingReplacement")

  signatureMethod    String?
  signatureProvider  String?
  signatureLevel     String?
  envelopeId         String?   @unique
  signingExpiresAt   DateTime?
  signedUploadedById String?
  signedUploadedAt   DateTime?

  completenessResult    Json?
  completenessCheckedAt DateTime?

  properties ShowingProperty[]
  parties    ShowingParty[]
  events     ShowingEvent[]
  tasks      Task[]
  milestones PaymentMilestone[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([contactId])
  @@index([leadId])
  @@index([responsibleUserId, status])
  @@index([sourceViewingId])
  @@index([createdAt])
  @@index([visitAt])
  @@map("showings")
}

/// One property in a showing. The columns are what was printed; the property
/// itself may later change, be unpublished, sold or deleted.
model ShowingProperty {
  id         String    @id @default(cuid())
  showingId  String
  showing    Showing   @relation(fields: [showingId], references: [id], onDelete: Restrict)
  /// Cleared (not cascaded) if the property record is deleted; the snapshot stays.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sortOrder  Int       @default(0)

  propertyCodeSnapshot    String
  addressSnapshot         String?
  descriptionSnapshot     String?
  transactionTypeSnapshot String
  propertyTypeSnapshot    String?
  areaSnapshot            Decimal?      @db.Decimal(10, 2)
  priceSnapshot           Decimal?      @db.Decimal(14, 2)
  currencySnapshot        String        @default("EUR")
  /// The fee as it applied to this property (net, VAT, gross), fixed at issue.
  commissionSnapshot      Json?
  vatTreatmentSnapshot    VatTreatment?
  /// Everything else the document may print about the property.
  propertySnapshot        Json

  createdAt DateTime @default(now())

  @@unique([showingId, propertyId])
  @@unique([showingId, sortOrder])
  @@index([propertyId])
  @@map("showing_properties")
}

/// Who the showing is for or signs it: a buyer or tenant, a joint buyer, a
/// company representative, an attorney-in-fact. Identity details are personal
/// data and stored encrypted, like MandateParty.
model ShowingParty {
  id        String           @id @default(cuid())
  showingId String
  showing   Showing          @relation(fields: [showingId], references: [id], onDelete: Restrict)
  role      ShowingPartyRole
  contactId String?
  contact   Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  fullName  String

  taxIdEncrypted     String?
  taxOfficeEncrypted String?
  idNumberEncrypted  String?
  addressEncrypted   String?
  emailEncrypted     String?
  phoneEncrypted     String?

  /// A person has checked the identity document; null = not verified.
  identityVerifiedAt     DateTime?
  identityVerifiedById   String?
  /// Signs on someone else's behalf, with this authority.
  representativeCapacity OwnerCapacity?
  authorityReference     String?
  isSignatory            Boolean        @default(true)

  sortOrder Int       @default(0)
  signedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([showingId])
  @@index([contactId])
  @@map("showing_parties")
}

/// Append-only, like MandateEvent.
model ShowingEvent {
  id        String   @id @default(cuid())
  showingId String
  showing   Showing  @relation(fields: [showingId], references: [id], onDelete: Restrict)
  type      String
  summary   String
  data      Json?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([showingId, createdAt])
  @@map("showing_events")
}

/// Who owns a property, in what capacity and share. Property.ownerId stays for
/// now as the primary contact; this is the full picture.
model PropertyOwner {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)

  /// 0–100. Null when the share is unknown or not relevant; never assumed to be 100.
  ownershipPercentage    Decimal?       @db.Decimal(5, 2)
  capacity               OwnerCapacity  @default(OWNER)
  isPrimaryContact       Boolean        @default(false)
  isSignatory            Boolean        @default(false)
  /// Set when this person signs in a capacity other than their own (attorney, representative).
  representativeCapacity OwnerCapacity?
  authorityDocumentId    String?
  authorityDocument      Document?      @relation("OwnerAuthorityDocument", fields: [authorityDocumentId], references: [id], onDelete: SetNull)
  authorityReference     String?

  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([contactId])
  @@map("property_owners")
}

/// A prolongation of an exclusive (or fixed-term) mandate. The mandate's own
/// end date is never overwritten; the effective end is the latest issued or
/// signed extension.
model MandateExtension {
  id        String  @id @default(cuid())
  mandateId String
  mandate   Mandate @relation(fields: [mandateId], references: [id], onDelete: Restrict)

  previousEndDate       DateTime               @db.Date
  newEndDate            DateTime               @db.Date
  extensionReason       String?
  /// The wording of the addendum as issued.
  extensionTextSnapshot String?
  templateVersionId     String?
  issuedAt              DateTime?
  signedAt              DateTime?
  status                MandateExtensionStatus @default(DRAFT)
  signedPdfStorageKey   String?
  signedPdfChecksum     String?

  /// The addendum's own number, `<mandate number>/Π<n>`; allocated when issued.
  number                    String?              @unique
  templateChecksum          String?
  renderedTextEncrypted     String?
  renderedTextChecksum      String?
  issuanceSnapshotEncrypted String?
  issuanceSnapshotChecksum  String?
  pdfStorageKey             String?
  pdfChecksum               String?
  storageState              DocumentStorageState @default(NOT_STORED)
  verificationCode          String?              @unique

  sentAt             DateTime?
  signatureMethod    String?
  signatureProvider  String?
  signatureLevel     String?
  envelopeId         String?   @unique
  signingExpiresAt   DateTime?
  signedUploadedById String?
  signedUploadedAt   DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([mandateId, status])
  @@map("mandate_extensions")
}

/// A manager's recorded decision to allow an exclusive mandate that overlaps another.
model MandateConflictOverride {
  id                   String   @id @default(cuid())
  mandateId            String
  mandate              Mandate  @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  conflictingMandateId String
  reason               String
  approvedById         String
  approvedAt           DateTime @default(now())

  @@unique([mandateId, conflictingMandateId])
  @@map("mandate_conflict_overrides")
}

/// One instalment of an agreed fee. Belongs to a mandate or a showing, not both.
model PaymentMilestone {
  id          String         @id @default(cuid())
  mandateId   String?
  mandate     Mandate?       @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  showingId   String?
  showing     Showing?       @relation(fields: [showingId], references: [id], onDelete: Restrict)
  sequence    Int
  /// Exactly one of percentage / fixedAmount is set.
  percentage  Decimal?       @db.Decimal(7, 4)
  fixedAmount Decimal?       @db.Decimal(14, 2)
  currency    String         @default("EUR")
  trigger     PaymentTrigger
  description String?
  /// Free description of when it falls due when the trigger is CUSTOM.
  dueDateRule String?
  createdAt   DateTime       @default(now())

  @@index([mandateId])
  @@index([showingId])
  @@map("payment_milestones")
}

/// Where a record came from in another system. Importing is idempotent: the
/// same legacy id maps to the same HOME88 record every time.
model LegacyEntityMapping {
  id                String             @id @default(cuid())
  /// HOME88 is a single office today; kept in the key so a second tenant never collides.
  organizationId    String             @default("home88")
  sourceSystem      LegacySourceSystem
  sourceEntityType  String
  legacyId          String
  targetEntityType  String
  targetEntityId    String
  importBatchId     String?
  sourcePayloadHash String?
  importedAt        DateTime           @default(now())
  importedByUserId  String?
  createdAt         DateTime           @default(now())

  @@unique([organizationId, sourceSystem, sourceEntityType, legacyId])
  @@index([targetEntityType, targetEntityId])
  @@index([importBatchId])
  @@map("legacy_entity_mappings")
}

// ---------------------------------------------------------------------------
// Document issuance (Phase B)
// ---------------------------------------------------------------------------

enum DocumentStorageState {
  NOT_STORED
  /// Issued, but the PDF is not yet verified at its final private key. Sending
  /// and signing are refused until it is.
  PENDING
  CONFIRMED
}

/// Append-only trail of everything that happens to a showing, mandate or
/// extension document (and the templates behind them). Personal data is masked
/// before it is written; the table never holds an identity number or a document text.
model DocumentAuditEvent {
  id             String   @id @default(cuid())
  type           String
  /// SHOWING, MANDATE, MANDATE_EXTENSION or TEMPLATE.
  entityType     String
  entityId       String
  documentNumber String?
  actorUserId    String?
  actorRole      String?
  occurredAt     DateTime @default(now())
  requestId      String?
  ipAddress      String?
  userAgent      String?
  before         Json?
  after          Json?
  reason         String?
  metadata       Json?

  @@index([entityType, entityId, occurredAt])
  @@index([type, occurredAt])
  @@index([documentNumber])
  @@map("document_audit_events")
}

// ---------------------------------------------------------------------------
// Contact ↔ property relationships (Phase C)
// ---------------------------------------------------------------------------

enum ContactPropertyRelation {
  BUYER
  TENANT
  INTERESTED
}

/// How a contact relates to a property when they are not an owner. Owners and
/// co-owners stay in property_owners (and Property.ownerId); this table holds
/// the relationships that had no home before, so nothing is stored twice.
model ContactProperty {
  id          String                  @id @default(cuid())
  contactId   String
  contact     Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  relation    ContactPropertyRelation
  notes       String?
  createdById String?
  createdAt   DateTime                @default(now())

  @@unique([contactId, propertyId, relation])
  @@index([propertyId])
  @@map("contact_properties")
}

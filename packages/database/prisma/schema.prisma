}

enum PortalSyncState {
  NOT_PUBLISHED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  REMOVED
  OUTDATED
  /// In a feed we serve; the portal has not confirmed it imported the listing.
  IN_FEED
}

/// Which side of a portal an account talks to. A TEST account can never be
/// used against production, and the choice is always explicit.
enum PortalEnvironment {

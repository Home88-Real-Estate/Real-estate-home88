  ACTIVE
  /// An offer is being negotiated; still marketed. Transitions are checked by
  /// @home88/domain (property-lifecycle.ts), never set directly by a client.
  UNDER_OFFER
  RESERVED
  SOLD
  RENTED
  INACTIVE
  ARCHIVED
  /// The CRM's deleted folder: hidden from listings, feeds and dashboards,
  /// restorable, or removable permanently by an administrator.
  DELETED
}

enum PropertyType {
  APARTMENT
  MAISONETTE
  HOUSE
  VILLA
  STUDIO
  OFFICE
  SHOP
  WAREHOUSE
  BUILDING
  HOTEL
  LAND
  PLOT
  PARKING
  INDUSTRIAL

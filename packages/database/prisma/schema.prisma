}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Lifecycle of a buyer/tenant request (Ζήτηση).
enum RequestStatus {
  ACTIVE
  PAUSED
  FULFILLED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentCategory {

// ---------------------------------------------------------------------------
// HOME88 — data model
//
// Design rules enforced here, not left to discipline:
//   1. Nothing user-facing is keyed on a database id. Properties and leads get
//      a human reference (H88-000001) from a counter table, so a public code is
//      stable across environments and re-orders.
//   2. Personal data is either auditable or deletable. Every table holding a
//      name/email/phone carries a retention path (see ComplianceAudit doc in
//      README) so an erasure request can find and purge it.
//   3. Consent is a first-class row, not a boolean. It records what was agreed,
//      to which version of which policy, when, and how to undo it.
//   4. Commercial communication is impossible to send without a suppression
//      check, because the suppression table is consulted by the mailer itself.
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  /// "native" for local machines; rhel-openssl-3.0.x is Vercel's runtime
  /// (Amazon Linux 2023), where the CRM deployment runs the API.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
  MARKETING
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum ListingType {
  SALE
  RENT
  /// Portal-only transaction type: the agency is seeking an assignment of the
  /// existing contract, not a new sale or tenancy.
  ASSIGNMENT
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  /// An offer is being negotiated; still marketed. Transitions are checked by
  /// @home88/domain (property-lifecycle.ts), never set directly by a client.
  UNDER_OFFER
  RESERVED
  SOLD
  RENTED
  INACTIVE
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  MAISONETTE
  HOUSE
  VILLA
  STUDIO
  OFFICE
  SHOP
  WAREHOUSE
  BUILDING
  HOTEL
  LAND
  PLOT
  PARKING
  INDUSTRIAL
  OTHER
}

enum PropertyCondition {
  NEW_BUILD
  RENOVATED
  GOOD
  NEEDS_RENOVATION
  UNDER_CONSTRUCTION
}

enum EnergyClass {
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  NOT_AVAILABLE
}

enum HeatingType {
  CENTRAL
  INDIVIDUAL
  UNDERFLOOR
  HEAT_PUMP
  GAS
  NONE
  NOT_AVAILABLE
}

enum MediaKind {
  PHOTO
  FLOOR_PLAN
  VIDEO
  VIRTUAL_TOUR
  DOCUMENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING
  OFFER
  WON
  LOST
  NOT_INTERESTED
}

enum LeadSource {
  WEBSITE
  PROPERTY_ENQUIRY
  PHONE
  WHATSAPP
  EMAIL
  SPITOGATOS
  XE_GR
  PORTAL_OTHER
  WALK_IN
  REFERRAL
  SOCIAL
  IMPORT
  OTHER
}

enum ContactRole {
  BUYER
  SELLER
  LANDLORD
  TENANT
  OTHER
}

enum PreferredContactMethod {
  PHONE
  EMAIL
  WHATSAPP
  SMS
  ANY
}

enum ViewingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Lifecycle of a buyer/tenant request (Ζήτηση).
enum RequestStatus {
  ACTIVE
  PAUSED
  FULFILLED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentCategory {
  CONTRACT
  DEED
  ID_VERIFICATION
  TAX
  INSPECTION
  APPRAISAL
  INVOICE
  OTHER
}

enum PortalTransport {
  /// Portal accepts a direct API call with our credentials.
  API
  /// Portal ingests an XML document we publish to a URL they poll or fetch.
  XML_FEED
  /// Portal ingests a CSV document.
  CSV_FEED
  /// We hand the listing to a human who posts it in the portal's UI.
  MANUAL
  /// Portal ingests a JSON document we publish to a URL they poll or fetch.
  JSON_FEED
}

enum PortalSyncState {
  NOT_PUBLISHED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  REMOVED
  OUTDATED
  /// In a feed we serve; the portal has not confirmed it imported the listing.
  IN_FEED
}

enum SyncAction {
  PUBLISH
  UPDATE
  REMOVE
  REPUBLISH
  IMPORT_LEADS
}

enum ConsentPurpose {
  /// Necessary for the service to operate (contract, enquiry handling).
  NECESSARY
  /// Analytics / measurement. Opt-in, revocable.
  ANALYTICS
  /// Marketing email. Opt-in, revocable, suppression-enforced.
  MARKETING
  /// Writing to the visitor about a specific property they asked about.
  PROPERTY_ENQUIRY
  /// Non-essential cookies such as session replay.
  SESSION_REPLAY
}

enum SuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  SUPPRESSED_BY_ADMIN
}

enum DataRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  PORTABILITY
  OBJECTION
  RESTRICTION
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum DmcaStatus {
  RECEIVED
  UNDER_REVIEW
  ACTIONED
  COUNTER_NOTICE
  CLOSED
  REJECTED
}

enum AuditEntity {
  PROPERTY
  LEAD
  CONTACT
  USER
  OFFER
  VIEWING
  TASK
  DOCUMENT
  PORTAL
  PORTAL_LISTING
  CONSENT
  EMAIL
  SETTINGS
  REQUEST
}

// ---------------------------------------------------------------------------
// Reference counters
//
// Postgres sequences cannot produce "H88-000001" without a function per
// prefix, and they cannot be reseeded independently per environment. A counter
// table is portable and makes the allocation transactional with the insert.
// ---------------------------------------------------------------------------

model ReferenceCounter {
  id        String   @id @default(cuid())
  scope     String   @unique
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// scrypt hash of the user's password. Null until the person sets one
  /// through the reset/invitation flow (e.g. the bootstrapped first admin):
  /// a null hash never authenticates.
  passwordHash String?
  /// The user's id in an external identity provider (the Supabase Auth
  /// `auth.users.id` of the same person), when one exists. Recorded so the
  /// same identity can never be mapped to two staff records. CRM sign-in does
  /// not use it: credentials are this table's own.
  authUid      String?    @unique @db.Uuid
  firstName    String
  lastName     String
  phone        String?
  role         UserRole   @default(AGENT)
  status       UserStatus @default(ACTIVE)

  /// Set by the age gate at invite/creation time. Users of this CRM are staff,
  /// so this is enforced rather than merely recorded.
  dateOfBirth DateTime? @db.Date

  avatarUrl String?
  locale    String  @default("el")

  properties          Property[]      @relation("PropertyAgent")
  ownedBy             Property[]      @relation("PropertyCreator")
  leads               Lead[]          @relation("LeadAssignee")
  viewings            Viewing[]
  tasks               Task[]          @relation("TaskAssignee")
  buyerRequests       BuyerRequest[]  @relation("RequestAssignee")
  notes               Note[]
  offers              Offer[]         @relation("OfferAgent")
  auditLogs           AuditLog[]
  consents            ConsentRecord[]
  createdBy           User?           @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById         String?
  createdUsers        User[]          @relation("UserCreatedBy")
  deactivatedBy       User?           @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedById     String?
  deactivatedUsers    User[]          @relation("UserDeactivatedBy")
  deactivatedAt       DateTime?
  deletionRequestedAt DateTime?
  erasureCompletedAt  DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  propertyStatusChanges PropertyStatusHistory[]
  propertyPriceChanges  PropertyPriceHistory[]
  invitationsSent       Invitation[]            @relation("InvitationInviter")

  @@index([role])
  @@index([status])
  @@index([email])
  @@map("users")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token that lives in the HttpOnly cookie. The raw
  /// token is never stored, so a database leak cannot be replayed as a session.
  tokenHash     String    @unique
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A staff invitation. An admin creates one; the invitee redeems it once to
/// create an ACTIVE user. Kept separate from User so no password (or a
/// placeholder hash) exists before the person sets their own.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole  @default(AGENT)
  firstName   String
  lastName    String
  phone       String?
  /// SHA-256 of the opaque token in the emailed link. The raw token is never stored.
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// People: owners, buyers, sellers, landlords, tenants
// ---------------------------------------------------------------------------

model Contact {
  id        String @id @default(cuid())
  reference String @unique

  firstName String
  lastName  String
  company   String?

  /// Held at rest encrypted; see apps/api for the envelope key. Never selected
  /// into list views or logs.
  emailEncrypted  String?
  emailHash       String?
  phoneEncrypted  String?
  mobileEncrypted String?

  roles            ContactRole[]
  taxIdEncrypted   String?
  addressEncrypted String?

  preferredContactMethod PreferredContactMethod @default(ANY)
  preferredLocale        String                 @default("el")

  notes         Note[]
  leads         Lead[]
  viewings      Viewing[]
  buyerRequests BuyerRequest[]
  offers        Offer[]
  properties    Property[]     @relation("PropertyOwner")
  documents     Document[]

  marketingOptOutAt  DateTime?
  erasureRequestedAt DateTime?
  retentionExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailHash])
  @@index([lastName])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Property
// ---------------------------------------------------------------------------

model Property {
  id        String @id @default(cuid())
  /// Public code, e.g. H88-000001. Allocated from ReferenceCounter('property').
  reference String @unique

  /// URL slug. Unique, and regenerated when the title changes.
  slug String @unique

  listingType  ListingType
  propertyType PropertyType
  status       PropertyStatus    @default(DRAFT)
  condition    PropertyCondition @default(GOOD)

  titleEl String
  titleEn String?

  descriptionEl String
  descriptionEn String?

  price          Decimal? @db.Decimal(14, 2)
  priceOnRequest Boolean  @default(false)
  /// Monthly price for RENT; total price for SALE. Lets offers sort correctly.
  monthlyRent    Decimal? @db.Decimal(14, 2)

  area      Decimal? @db.Decimal(10, 2)
  plotArea  Decimal? @db.Decimal(10, 2)
  builtArea Decimal? @db.Decimal(10, 2)

  bedrooms    Int?
  bathrooms   Int?
  wc          Int?
  floor       Int?
  totalFloors Int?

  yearBuilt     Int?
  yearRenovated Int?

  heating     HeatingType @default(NOT_AVAILABLE)
  energyClass EnergyClass @default(NOT_AVAILABLE)
  hasSolar    Boolean     @default(false)

  parking         Boolean  @default(false)
  parkingSpaces   Int?
  storage         Boolean  @default(false)
  balcony         Boolean  @default(false)
  balconyArea     Decimal? @db.Decimal(8, 2)
  garden          Boolean  @default(false)
  pool            Boolean  @default(false)
  furnished       Boolean  @default(false)
  petsAllowed     Boolean  @default(false)
  seaView         Boolean  @default(false)
  newConstruction Boolean  @default(false)

  region       String?
  city         String?
  areaName     String?
  neighborhood String?
  address      String?
  postalCode   String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  videoUrl       String?
  virtualTourUrl String?

  /// Surfaced on the website once true. Independent of PropertyStatus so a
  /// listing can be hidden without being delisted from portals.
  publishedOnWebsite Boolean   @default(false)
  publishedAt        DateTime?
  featured           Boolean   @default(false)

  agentId String?
  agent   User?   @relation("PropertyAgent", fields: [agentId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   Contact? @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PropertyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  media          PropertyMedia[]
  leads          Lead[]
  viewings       Viewing[]
  offers         Offer[]
  documents      Document[]
  portalListings PortalListing[]
  tagAssignments PropertyTagAssignment[]
  notes          Note[]
  dmcaNotices    DmcaNotice[]
  tasks          Task[]
  statusHistory  PropertyStatusHistory[]
  priceHistory   PropertyPriceHistory[]

  /// Commission is stored as a rate, not a hard-coded percentage.
  commissionRatePct  Decimal? @db.Decimal(5, 2)
  agentCommissionPct Decimal? @db.Decimal(5, 2)
  /// Type- and listing-specific attributes, validated by property-profiles in @home88/domain.
  details            Json?

  /// Non-nullable retention anchor, used by the purge job.
  retentionExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([listingType])
  @@index([propertyType])
  @@index([reference])
  @@index([publishedOnWebsite, status])
  @@index([city])
  @@index([neighborhood])
  @@index([price])
  @@index([area])
  @@index([bedrooms])
  @@index([agentId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("properties")
}

/// Every status transition, written in the same transaction as the change.
/// `fromStatus` is null only for a property's creation.
model PropertyStatusHistory {
  id         String          @id @default(cuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromStatus PropertyStatus?
  toStatus   PropertyStatus
  reason     String?
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([propertyId, createdAt])
  @@index([toStatus, createdAt])
  @@map("property_status_history")
}

/// Asking price / monthly rent changes. Prices are never overwritten without
/// a row here, so reductions and time-at-price can be reported.
model PropertyPriceHistory {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromPrice       Decimal? @db.Decimal(14, 2)
  toPrice         Decimal? @db.Decimal(14, 2)
  fromMonthlyRent Decimal? @db.Decimal(14, 2)
  toMonthlyRent   Decimal? @db.Decimal(14, 2)
  actorId         String?
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([propertyId, createdAt])
  @@map("property_price_history")
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  kind MediaKind @default(PHOTO)

  /// Object-storage key, never a public URL. A signed URL is generated per
  /// request so a leaked link expires. Unique: confirming the same upload
  /// twice (a retry) never creates a second row.
  storageKey   String  @unique
  /// Browser-made web-sized JPEG (long edge ≤ 2048px) and thumbnail of a
  /// photo, stored next to the original. Null for older rows and non-images.
  previewKey   String?
  thumbnailKey String?
  originalName String?
  mimeType     String
  byteSize     Int
  width        Int?
  height       Int?

  altEl String?
  altEn String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  /// Moderation state. Nothing uploads straight to public-serving state.
  status String @default("pending_review")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, kind, sortOrder])
  @@index([propertyId, isPrimary])
  @@index([status])
  @@map("property_media")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id        String @id @default(cuid())
  /// Public code, e.g. H88-000184. Allocated from ReferenceCounter('lead').
  reference String @unique

  firstName String
  lastName  String?
  email     String?
  phone     String?
  message   String?

  status          LeadStatus @default(NEW)
  source          LeadSource @default(WEBSITE)
  /// Portal-side identifiers, so a lead can be traced back to its origin.
  sourcePortalId  String?
  sourceListingId String?
  sourceUrl       String?

  preferredContactMethod PreferredContactMethod @default(ANY)
  locale                 String                 @default("el")

  budgetMin Decimal? @db.Decimal(14, 2)
  budgetMax Decimal? @db.Decimal(14, 2)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  notes    Note[]
  viewings Viewing[]
  offers   Offer[]
  tasks    Task[]

  /// Compliance state for this enquiry.
  consentRecordId    String?
  marketingOptOutAt  DateTime?
  retentionExpiresAt DateTime?
  erasureRequestedAt DateTime?

  /// Verified at capture time by the server-side age gate. Stored as a boolean
  /// decision, never a raw date of birth.
  ageVerifiedAt       DateTime?
  ageVerificationFail Boolean   @default(false)

  lastContactedAt DateTime?
  nextActionAt    DateTime?
  lostReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([sourcePortalId])
  @@index([assignedToId, status])
  @@index([propertyId])
  @@index([createdAt])
  @@index([nextActionAt])
  @@index([assignedToId, createdAt])
  @@map("leads")
}

model Note {
  id        String  @id @default(cuid())
  body      String
  isPrivate Boolean @default(false)

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([propertyId])
  @@map("notes")
}

model Viewing {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Snapshot of who attended, kept even if the linked contact is later erased.
  clientName  String
  clientPhone String?
  clientEmail String?

  startsAt DateTime
  endsAt   DateTime?
  status   ViewingStatus @default(SCHEDULED)
  feedback String?
  outcome  String?

  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, startsAt])
  @@index([agentId, startsAt])
  @@index([status])
  @@index([status, startsAt])
  @@index([startsAt])
  @@map("viewings")
}

model Offer {
  id        String @id @default(cuid())
  reference String @unique

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  amount     Decimal     @db.Decimal(14, 2)
  status     OfferStatus @default(SUBMITTED)
  conditions String?
  expiresAt  DateTime?
  notes      String?

  agentId String?
  agent   User?   @relation("OfferAgent", fields: [agentId], references: [id], onDelete: SetNull)

  commissionAmount      Decimal?  @db.Decimal(14, 2)
  agentCommissionAmount Decimal?  @db.Decimal(14, 2)
  closedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([leadId])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@map("offers")
}

/// A client's search criteria (Ζήτηση): what they want to buy or rent.
/// Matched against properties by @home88/domain request-matching.
model BuyerRequest {
  id        String @id @default(cuid())
  reference String @unique

  status        RequestStatus  @default(ACTIVE)
  listingType   ListingType
  /// Empty = any type.
  propertyTypes PropertyType[]
  /// Free-text areas (city, area or neighbourhood names).
  areas         String[]

  minPrice     Decimal? @db.Decimal(14, 2)
  maxPrice     Decimal? @db.Decimal(14, 2)
  minArea      Decimal? @db.Decimal(10, 2)
  maxArea      Decimal? @db.Decimal(10, 2)
  minBedrooms  Int?
  minBathrooms Int?
  minFloor     Int?
  minYearBuilt Int?
  /// Required features, as property-profile keys (parking, storage, elevator, ...).
  features     String[]

  clientName  String
  clientPhone String?
  clientEmail String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// 1-5: how promising the client is.
  rating    Int?
  notes     String?
  expiresAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, listingType])
  @@index([assignedToId, status])
  @@index([createdAt])
  @@map("buyer_requests")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(NORMAL)

  dueAt       DateTime?
  completedAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewingId  String?
  viewing    Viewing?  @relation(fields: [viewingId], references: [id], onDelete: Cascade)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedToId, status])
  @@index([dueAt])
  @@index([status, priority])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Documents
//
// Never a public bucket. Every read goes through a signed URL after an
// authorisation check.
// ---------------------------------------------------------------------------

model Document {
  id         String    @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  title      String
  category   DocumentCategory @default(OTHER)
  storageKey String
  mimeType   String
  byteSize   Int
  checksum   String?

  /// Documents containing personal data are removed with the person.
  containsPersonalData Boolean   @default(false)
  retentionExpiresAt   DateTime?

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId])
  @@index([contactId])
  @@index([retentionExpiresAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Portal publishing
//
// A portal is a configuration row. How it is written to is a PortalAdapter, so
// adding Spitogatos or XE.gr never touches the property code.
// ---------------------------------------------------------------------------

model Portal {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  transport PortalTransport @default(MANUAL)
  enabled   Boolean         @default(false)

  baseUrl        String?
  feedUrl        String?
  /// Opaque per-portal credentials, referenced by key in apps/api config.
  /// Never stored as usable plaintext.
  credentialsRef String?

  /// Portals generally require an agent id on every listing.
  defaultAgentExternalId String?

  settings Json?

  /// Facts behind the status shown in Settings → Portals. Nothing reads as
  /// "connected" until a sync has actually succeeded.
  lastSyncAt    DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  /// Short, credential-free description of the last failure.
  lastError     String?

  listings        PortalListing[]
  syncLogs        PortalSyncLog[]
  mappings        PortalPropertyMapping[]
  publicationRule PortalPublicationRule?
  taxonomy        PortalMapping[]
  feedVersions    PortalFeedVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("portals")
}

model PortalListing {
  id         String   @id @default(cuid())
  portalId   String
  portal     Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  externalId   String?
  externalUrl  String?
  state        PortalSyncState @default(NOT_PUBLISHED)
  lastSyncedAt DateTime?
  lastError    String?
  retryCount   Int             @default(0)

  /// Hash of the payload last sent, so an unchanged property is not re-pushed.
  lastPayloadHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncLogs PortalSyncLog[]

  @@unique([portalId, propertyId])
  @@index([portalId, state])
  @@index([propertyId])
  @@index([state])
  @@map("portal_listings")
}

model PortalSyncLog {
  id              String         @id @default(cuid())
  portalId        String
  portal          Portal         @relation(fields: [portalId], references: [id], onDelete: Cascade)
  portalListingId String?
  portalListing   PortalListing? @relation(fields: [portalListingId], references: [id], onDelete: SetNull)
  propertyId      String?

  action     SyncAction
  ok         Boolean
  detail     String?
  errorCode  String?
  durationMs Int?

  actorId   String?
  createdAt DateTime @default(now())

  @@index([portalId, createdAt])
  @@index([portalListingId])
  @@index([ok])
  @@map("portal_sync_logs")
}

/// Correlates our property reference to a portal's own identifier, so a
/// listing deleted on our side can still be removed on theirs.
model PortalPropertyMapping {
  id         String @id @default(cuid())
  portalId   String
  portal     Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  propertyId String

  externalId    String
  externalUrl   String?
  lastConfirmed DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portalId, propertyId])
  @@unique([portalId, externalId])
  @@index([propertyId])
  @@map("portal_property_mappings")
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

/// Every consent decision, granted or withdrawn. The privacy policy states the
/// processor list; this table states what each individual actually agreed to.
model ConsentRecord {
  id String @id @default(cuid())

  /// Hashed subject identifier. Raw email is not stored here.
  subjectHash String
  email       String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String

  /// How the choice was captured.
  source    String
  ipAddress String?
  userAgent String?

  grantedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectHash, purpose])
  @@index([email])
  @@index([purpose, granted])
  @@index([createdAt])
  @@map("consent_records")
}

/// Checked by the mailer before every commercial send. Also populated from
/// hard bounces and spam complaints.
model EmailSuppression {
  id           String            @id @default(cuid())
  email        String
  emailHash    String            @unique
  reason       SuppressionReason
  source       String?
  /// When the original consent was withdrawn, for the 10-business-day record.
  suppressedAt DateTime          @default(now())
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([reason])
  @@map("email_suppressions")
}

/// GDPR / Greek data-subject requests, so requests are auditable rather than
/// handled ad hoc in someone's inbox.
model DataRequest {
  id        String            @id @default(cuid())
  reference String            @unique
  type      DataRequestType
  status    DataRequestStatus @default(OPEN)

  subjectName  String
  subjectEmail String
  subjectHash  String

  /// Which tables were inspected and what was erased.
  findings    Json?
  completedAt DateTime?
  dueAt       DateTime?
  notes       String?

  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subjectEmail])
  @@index([status])
  @@index([dueAt])
  @@map("data_requests")
}

/// DMCA / copyright takedown notices for user-uploaded material.
model DmcaNotice {
  id        String @id @default(cuid())
  reference String @unique

  /// Copyright holder's details, retained as supplied in the notice.
  claimantName    String
  claimantEmail   String
  claimantAddress String?

  originalWorkUrl String?
  workDescription String?

  /// Our material under complaint.
  infringingUrl String?
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  mediaId       String?
  contactId     String?

  goodFaithStatement String?
  signature          String?

  status                DmcaStatus @default(RECEIVED)
  counterNoticeReceived Boolean    @default(false)
  actionTakenAt         DateTime?
  resolvedAt            DateTime?
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([propertyId])
  @@index([createdAt])
  @@map("dmca_notices")
}

/// Append-only. Property and lead history is written here so a status change
/// cannot be made without leaving a record of who did it.
model AuditLog {
  id       String      @id @default(cuid())
  entity   AuditEntity
  entityId String

  action    String
  /// Field-level before/after, with personal fields redacted.
  changes   Json?
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Every outbound message, so "was this person ever emailed" is answerable and
/// an unsubscribe can be honoured against a specific send.
model EmailLog {
  id      String @id @default(cuid())
  toEmail String
  subject String

  /// TRANSACTIONAL is exempt from marketing consent and suppression rules.
  /// MARKETING is never sent without a current grant and a clear suppression list.
  category String

  template          String?
  providerMessageId String?

  /// Set when the recipient used the one-click unsubscribe endpoint.
  unsubscribedAt DateTime?

  consentRecordId String?
  metadata        Json?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toEmail])
  @@index([category])
  @@index([createdAt])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Settings
//
// One typed table per settings area (a single row with id "default"), so a
// column has a real type and a missing value is NULL ("not configured")
// rather than a guess. The catalogue in @home88/domain describes every column:
// labels, validation and which values are secrets.
//
// Secrets never live in these tables. They are AES-256-GCM envelopes in
// provider_credentials, written through the API and never returned by it.
// ---------------------------------------------------------------------------

model CompanySettings {
  id          String   @id @default("default")
  officeName  String?
  legalName   String?
  website     String?
  email       String?
  phone1      String?
  phone2      String?
  mobile      String?
  addressEl   String?
  addressEn   String?
  city        String?
  postalCode  String?
  country     String?
  hoursEl     String?
  hoursEn     String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("company_settings")
}

/// One row per platform (FACEBOOK, INSTAGRAM, …). Legacy platforms such as
/// Google+ may exist from a migration but are never offered for new entries.
model CompanySocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  updatedAt DateTime @updatedAt

  @@map("company_social_links")
}

/// Company profile text, one row per language.
model CompanyProfile {
  id        String   @id @default(cuid())
  locale    String   @unique
  body      String
  updatedAt DateTime @updatedAt

  @@map("company_profiles")
}

model CompanyLegalDetails {
  id                  String   @id @default("default")
  legalNameEl         String?
  legalNameEn         String?
  activityEl          String?
  activityEn          String?
  vatNumber           String?
  taxOffice           String?
  gemiNumber          String?
  kefodeEl            String?
  kefodeEn            String?
  registeredAddressEl String?
  registeredAddressEn String?
  phone               String?
  legalEmail          String?
  updatedAt           DateTime @updatedAt
  updatedById         String?

  @@map("company_legal_details")
}

model CompanyBranding {
  id                 String   @id @default("default")
  logoUrl            String?
  faviconUrl         String?
  colorPrimary       String?
  colorDark          String?
  colorSecondary     String?
  colorBackground    String?
  siteTitle          String?
  siteDescription    String?
  defaultLanguage    String?
  availableLanguages String[] @default([])
  updatedAt          DateTime @updatedAt
  updatedById        String?

  @@map("company_branding")
}

model AppSettings {
  id                     String   @id @default("default")
  listingFooterEl        String?
  listingFooterEn        String?
  uppercaseDescriptions  Boolean?
  uploadMode             String?
  watermarkEnabled       Boolean?
  watermarkPosition      String?
  allowDuplicateContacts Boolean?
  showCustomerNames      String?
  showContactDetails     String?
  propertyRefreshDays    Int?
  requestRefreshDays     Int?
  mapDefaultLat          Float?
  mapDefaultLng          Float?
  showExactLocation      Boolean?
  /// Browser-side Maps key: visible to visitors by design, restricted by domain.
  mapsBrowserKey         String?
  timezone               String?
  currency               String?
  updatedAt              DateTime @updatedAt
  updatedById            String?

  @@map("app_settings")
}

model PropertySettings {
  id                        String   @id @default("default")
  approvalRequired          Boolean?
  minPhotosToPublish        Int?
  requireEnglishDescription Boolean?
  requireEnergyClass        Boolean?
  staleAfterDays            Int?
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("property_settings")
}

model ContactSettings {
  id                   String   @id @default("default")
  duplicateCheckPhone  Boolean?
  duplicateCheckEmail  Boolean?
  duplicateCheckName   Boolean?
  enabledSources       String[] @default([])
  defaultContactMethod String?
  updatedAt            DateTime @updatedAt
  updatedById          String?

  @@map("contact_settings")
}

model RequestSettings {
  id                String   @id @default("default")
  minMatchScore     Int?
  maxMatches        Int?
  priceTolerancePct Int?
  sizeTolerancePct  Int?
  weightArea        Int?
  weightPrice       Int?
  weightSize        Int?
  weightBedrooms    Int?
  weightBathrooms   Int?
  weightFloor       Int?
  weightYear        Int?
  weightFeatures    Int?
  expiryDays        Int?
  newMatchAlerts    String?
  updatedAt         DateTime @updatedAt
  updatedById       String?

  @@map("request_settings")
}

/// Every rate starts NULL: HOME88 supplies its own commission rules.
model CommissionSettings {
  id                      String   @id @default("default")
  saleCommissionPct       Decimal? @db.Decimal(7, 3)
  rentCommissionMonths    Decimal? @db.Decimal(6, 2)
  assignmentCommissionPct Decimal? @db.Decimal(7, 3)
  minimumFee              Decimal? @db.Decimal(12, 2)
  buyerSidePct            Decimal? @db.Decimal(7, 3)
  sellerSidePct           Decimal? @db.Decimal(7, 3)
  agentSharePct           Decimal? @db.Decimal(7, 3)
  agencySharePct          Decimal? @db.Decimal(7, 3)
  vatMode                 String?
  vatRatePct              Decimal? @db.Decimal(7, 3)
  updatedAt               DateTime @updatedAt
  updatedById             String?

  @@map("commission_settings")
}

model CalendarSettings {
  id                        String   @id @default("default")
  timezone                  String?
  workingDays               Int[]    @default([])
  workdayStart              String?
  workdayEnd                String?
  viewingMinutes            Int?
  defaultAppointmentMinutes Int?
  reminderMinutesBefore     Int?
  enabledEventCategories    String[] @default([])
  updatedAt                 DateTime @updatedAt
  updatedById               String?

  @@map("calendar_settings")
}

/// Event × channel switches. A missing row means the default (CRM on, email and SMS off).
model NotificationSetting {
  id          String   @id @default(cuid())
  event       String
  channel     String
  enabled     Boolean
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([event, channel])
  @@map("notification_settings")
}

model MandateSettings {
  id                   String   @id @default("default")
  numberingPrefix      String?
  numberingDigits      Int?
  signatureProvider    String?
  signatureLevel       String?
  signatureApiUrl      String?
  signatureAccountId   String?
  signingExpiryDays    Int?
  reminderScheduleDays Int[]    @default([])
  retentionYears       Int?
  updatedAt            DateTime @updatedAt
  updatedById          String?

  @@map("mandate_settings")
}

/// One template per mandate type and language. Its wording lives in versions.
model MandateTemplate {
  id        String                   @id @default(cuid())
  type      String
  locale    String
  createdAt DateTime                 @default(now())
  versions  MandateTemplateVersion[]

  @@unique([type, locale])
  @@map("mandate_templates")
}

/// Lawyer-approved wording. A version is editable only while DRAFT; once
/// ACTIVE or RETIRED its body never changes, so a signed mandate always points
/// at the exact text that was signed.
model MandateTemplateVersion {
  id            String          @id @default(cuid())
  templateId    String
  template      MandateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version       Int
  status        String          @default("DRAFT")
  body          String
  /// SHA-256 of body, recorded so a stored copy can be verified later.
  checksum      String
  notes         String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  activatedAt   DateTime?
  activatedById String?
  retiredAt     DateTime?

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("mandate_template_versions")
}

model EmailSettings {
  id           String   @id @default("default")
  mode         String?
  apiProvider  String?
  smtpHost     String?
  smtpPort     Int?
  smtpUsername String?
  smtpTls      Boolean?
  fromName     String?
  fromEmail    String?
  replyTo      String?
  disclaimerEl String?
  disclaimerEn String?
  updatedAt    DateTime @updatedAt
  updatedById  String?

  @@map("email_settings")
}

model SmsSettings {
  id          String   @id @default("default")
  provider    String?
  senderName  String?
  accountId   String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("sms_settings")
}

model SecuritySettings {
  id                  String   @id @default("default")
  sessionTimeoutHours Int?
  passwordMinLength   Int?
  maxLoginAttempts    Int?
  lockoutMinutes      Int?
  mfaPolicy           String?
  updatedAt           DateTime @updatedAt
  updatedById         String?

  @@map("security_settings")
}

/// Retention periods have no default: they are set after legal review.
model PrivacySettings {
  id                      String   @id @default("default")
  privacyEmail            String?
  dmcaEmail               String?
  analyticsEnabled        Boolean?
  marketingDoubleOptIn    Boolean?
  leadRetentionMonths     Int?
  contactRetentionMonths  Int?
  emailLogRetentionMonths Int?
  auditRetentionMonths    Int?
  updatedAt               DateTime @updatedAt
  updatedById             String?

  @@map("privacy_settings")
}

model SubscriptionSettings {
  id          String    @id @default("default")
  plan        String?
  status      String?
  startsAt    DateTime? @db.Date
  expiresAt   DateTime? @db.Date
  renewal     String?
  updatedAt   DateTime  @updatedAt
  updatedById String?

  @@map("subscription_settings")
}

/// Write-only provider secrets: AES-256-GCM, bound to (scope, field) as
/// associated data so an envelope cannot be moved to another field. The key
/// is SETTINGS_ENCRYPTION_KEY in the server environment; keyId records which
/// key wrote the envelope.
model ProviderCredential {
  id          String   @id @default(cuid())
  scope       String
  field       String
  ciphertext  String
  iv          String
  authTag     String
  keyId       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([scope, field])
  @@map("provider_credentials")
}

/// Who changed which setting, when. Secrets and sensitive identifiers are
/// recorded as "changed — value masked" with no old or new value, ever.
model SettingsAuditLog {
  id        String   @id @default(cuid())
  section   String
  field     String?
  action    String
  oldValue  Json?
  newValue  Json?
  masked    Boolean  @default(false)
  summary   String?
  actorId   String?
  actorName String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([section, createdAt])
  @@index([createdAt])
  @@map("settings_audit_log")
}

/// Overrides of the default settings grants per role. SUPER_ADMIN always
/// holds everything and is never stored here.
model RolePermission {
  id          String   @id @default(cuid())
  role        UserRole
  permission  String
  granted     Boolean
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([role, permission])
  @@map("role_permissions")
}

/// Internal property tags with stable codes (replacing Estate+ free-text
/// categories). Never shown on the public website.
model PropertyTag {
  id           String   @id @default(cuid())
  code         String   @unique
  labelEl      String
  labelEn      String?
  color        String   @default("slate")
  active       Boolean  @default(true)
  isSystem     Boolean  @default(false)
  /// Estate+ category names that map to this tag, for the data migration.
  legacyLabels String[] @default([])
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments PropertyTagAssignment[]

  @@map("property_tags")
}

/// Which internal tags a property carries. Tag codes are stable, so portal
/// publication rules (and the DO_NOT_PUBLISH flag) match on them rather than on
/// free-text notes.
model PropertyTagAssignment {
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tagId       String
  tag         PropertyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime    @default(now())

  @@id([propertyId, tagId])
  @@index([tagId])
  @@map("property_tag_assignments")
}

/// Region › City › Area › Neighbourhood.
model Area {
  id        String                @id @default(cuid())
  level     String
  parentId  String?
  parent    Area?                 @relation("AreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Area[]                @relation("AreaTree")
  nameEl    String
  nameEn    String?
  slug      String                @unique
  active    Boolean               @default(true)
  sortOrder Int                   @default(0)
  mappings  AreaExternalMapping[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([parentId])
  @@index([level])
  @@map("areas")
}

/// A portal's own id for an area (e.g. Spitogatos area id), so portal ids are
/// never hard-coded in property code.
model AreaExternalMapping {
  id         String   @id @default(cuid())
  areaId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  portalCode String
  externalId String
  updatedAt  DateTime @updatedAt

  @@unique([areaId, portalCode])
  @@index([portalCode, externalId])
  @@map("area_external_mappings")
}

model PortalPublicationRule {
  id            String   @id @default(cuid())
  portalId      String   @unique
  portal        Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  mode          String   @default("NONE")
  propertyTypes String[] @default([])
  includeTags   String[] @default([])
  excludeTags   String[] @default([])
  /// Optional narrowing on top of `mode` (listing types, cities, price and area
  /// bounds, required tags). Parsed defensively by @home88/portals.
  conditions    Json?
  updatedAt     DateTime @updatedAt
  updatedById   String?

  @@map("portal_publication_rules")
}

enum PortalMappingKind {
  TYPE
  FEATURE
}

enum PortalMappingStatus {
  MAPPED
  UNSUPPORTED
  TRANSFORM
}

/// How one portal names a HOME88 property type or feature. Kept as data so no
/// portal's vocabulary is hard-coded in property code. Locations are mapped by
/// AreaExternalMapping.
model PortalMapping {
  id            String              @id @default(cuid())
  portalId      String
  portal        Portal              @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind          PortalMappingKind
  internalCode  String
  status        PortalMappingStatus @default(MAPPED)
  externalValue String?
  updatedById   String?
  updatedAt     DateTime            @updatedAt

  @@unique([portalId, kind, internalCode])
  @@map("portal_mappings")
}

/// One row per distinct feed we generated for a portal. A feed whose size
/// collapsed against the last confirmed one is recorded as blocked and is not
/// served until a manager approves it.
model PortalFeedVersion {
  id            String    @id @default(cuid())
  portalId      String
  portal        Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  version       Int
  schemaVersion String
  propertyCount Int
  checksum      String
  generatedAt   DateTime  @default(now())
  blocked       Boolean   @default(false)
  blockReason   String?
  approvedAt    DateTime?
  approvedById  String?

  @@unique([portalId, version])
  @@index([portalId, generatedAt])
  @@map("portal_feed_versions")
}

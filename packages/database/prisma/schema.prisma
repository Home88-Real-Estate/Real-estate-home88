}

enum PortalAccountStatus {
  CONFIGURED
  TESTING
  ACTIVE
  PAUSED
  ERROR
}

enum PortalRunTrigger {
  MANUAL
  PROPERTY_SAVE
  CRON
  RETRY
  BULK_ACTION
}

enum PortalRunOperation {
  CONNECTION_TEST
  PREVIEW
  PUBLISH
  UPDATE
  UNPUBLISH
  RETRY
}

enum PortalRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL

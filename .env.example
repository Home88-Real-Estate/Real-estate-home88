# ---------------------------------------------------------------------------
# Copy to .env and fill in locally. NEVER commit a filled-in .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local Docker (see docker-compose.yml)
DATABASE_URL="postgresql://home88:home88_local_dev_only@localhost:5432/home88?schema=public"

# Supabase hosted (replace password locally, never in this file or in chat)
# DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?schema=public"

# --- Cache / queues --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth ------------------------------------------------------------------
# Generate per environment. Rotating this invalidates all sessions.
JWT_SECRET=""
# Minimum length enforced by apps/api at boot: 32 characters.
SESSION_TTL_HOURS="12"
PASSWORD_HASH_ROUNDS="12"

# --- Object storage (property photos, floor plans, documents) ---------------
# Local MinIO from docker-compose.yml
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="home88-properties"
S3_FORCE_PATH_STYLE="true"
# Signed-URL lifetime in seconds.
S3_SIGNED_URL_TTL="900"
# Hard upload ceiling enforced server-side, in bytes (25 MB).
MAX_UPLOAD_BYTES="26214400"

# --- App -------------------------------------------------------------------
# These values are read on the server only: nothing in apps/web imports this
# config from a client component. apps/web therefore accepts either the plain
# name or the NEXT_PUBLIC_ spelling, and prefers the plain one — hosting
# platforms warn that NEXT_PUBLIC_ values are exposed to the browser, which does
# not apply here and would block setting the name at all on some dashboards.
#
# The public website needs no API origin: it serves its own route handlers and
# reads the database directly, so every browser call is same-origin. Only
# apps/crm needs the deployed API, as API_URL (see apps/crm/.env.example).
SITE_URL="http://localhost:3000"
# Where the footer's staff sign-in link points (see docs/deployment.md):
#  - Default (blank CRM_URL and CRM_ORIGIN): production links to the HOME88 CRM
#    deployment, https://real-estate-home88-iota.vercel.app/crm/login, and /crm on
#    the site redirects there.
#  - CRM_URL: another CRM origin (e.g. https://crm.home88.estate once its DNS
#    exists). Development defaults to :3100.
#  - CRM_ORIGIN: serve the CRM on the site's own /crm instead (rewrite).
CRM_ORIGIN=""
CRM_URL="http://localhost:3100"
# Path prefix the CRM is served under (basePath in apps/crm). Must match on the
# API (to build reset links) and on the public site (to link to staff sign-in).
# Changing it requires a rebuild, because Next inlines it into the client.
CRM_BASE_PATH="/crm"
NEXT_PUBLIC_CRM_BASE_PATH="/crm"
# Public base URL for property media. Blank falls back to /media/<key> on the
# website and ${SITE_URL}/media in portal feeds.
MEDIA_BASE_URL=""
NEXT_PUBLIC_MEDIA_BASE_URL=""

# --- Personal-data protection (public website) ------------------------------
# Pepper mixed into the email/subject hash stored on contacts, leads and the
# consent ledger. Changing it invalidates existing hash lookups.
PII_HASH_PEPPER=""
# 32-byte base64 key for AES-256-GCM envelope encryption of Contact email/phone.
# If blank, the encrypted columns stay null and nothing is written in plaintext
# as a fallback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=""
# HMAC secret for one-click unsubscribe links. Falls back to JWT_SECRET, then to
# PII_HASH_PEPPER. If all are blank the mailer must use a preference-centre link
# instead of minting an unauthenticated one.
UNSUBSCRIBE_SECRET=""

# --- Website refresh after publishing (server-only; SAME value in the CRM and the website)
# The website caches property pages for a few minutes. With this set, publishing,
# updating or taking a listing down also refreshes the cached page at once
# (CRM -> POST {SITE_URL}/api/revalidate). Empty = not configured: every change is
# still correct in the database and the page converges when its cache expires.
# Generate with: openssl rand -base64 32
WEBSITE_REVALIDATE_SECRET=""

# --- Public AI assistant (Gemini) --------------------------------------------
# Server-side secrets only: set them in the deployment's environment (e.g. the
# Vercel project settings), never with a NEXT_PUBLIC_/VITE_ prefix and never in
# the repository. Without GEMINI_API_KEY the assistant is simply not shown.
GEMINI_API_KEY=
# Blank uses the current Flash alias (gemini-flash-latest); pin a model name to freeze it.
GEMINI_MODEL=
# Property intake assistant (voice/text), see docs/property-intake.md. The key above is shared;
# these are optional overrides. Set GEMINI_API_KEY on the CRM project as a Sensitive variable.
# GEMINI_INTAKE_TEXT_MODEL=  GEMINI_INTAKE_TRANSCRIBE_MODEL=gemini-3.5-flash  GEMINI_INTAKE_TRANSCRIBE_MODE=(asr|prompt)  GEMINI_INTAKE_TTS_MODEL=  GEMINI_INTAKE_TTS_VOICE=Kore
# INTAKE_MAX_AUDIO_BYTES=3145728  INTAKE_RATE_TURNS=60  INTAKE_RATE_TRANSCRIBE=40  INTAKE_RATE_SPEAK=60  INTAKE_RATE_PHOTOS=15
# Optional limits (defaults in apps/web/src/lib/ai/config.ts):
# AI_RATE_LIMIT_POINTS=20  AI_RATE_LIMIT_WINDOW_SECONDS=600  AI_MAX_MESSAGE_CHARS=1000
# AI_MAX_OUTPUT_TOKENS=700  AI_TIMEOUT_MS=20000  AI_MAX_TOOL_ROUNDS=4

# --- Legal / compliance ---------------------------------------------------
# Bump when the privacy notice or cookie policy changes materially. Consent
# records store the version that was agreed to.
POLICY_VERSION="2026-10-01"
# The entity that appears in privacy notices, marketing footers and
# copyright takedown notices. Must be a real, monitored mailbox.
COMPANY_LEGAL_NAME=""
COMPANY_POSTAL_ADDRESS=""
COMPANY_PRIVACY_EMAIL=""
COMPANY_DMCA_EMAIL=""
# Public contact details shown in the header/footer. Phone and hours have
# published defaults (2166003838 and the office hours below); contact email is
# only shown when set.
COMPANY_PHONE="2166003838"
COMPANY_CONTACT_EMAIL=""
COMPANY_HOURS="Δευτέρα - Παρασκευή 09:00 - 17:00, Σάββατο 10:00 - 14:00"

# --- Email (transactional vs marketing are enforced separately) -----------
# Leave SMTP_* blank to run in "log-only" mode, where mail is written to
# stdout instead of being sent. Nothing is ever delivered by accident.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="HOME88"

# --- Supabase Auth (first sign-in of a linked account) ---------------------
# The publishable key is public by design. With it, a staff account that has
# no CRM password yet can sign in once with its linked Supabase Auth password
# (see docs/authentication.md). SUPABASE_URL is derived from DATABASE_URL when
# it points at Supabase.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# --- Seed (development only) ----------------------------------------------
# `npm run db:seed` refuses to run without SEED_ADMIN_PASSWORD. The other demo
# staff reuse it unless SEED_AGENT_PASSWORD is set. Never use these in prod.
SEED_ADMIN_EMAIL="admin@home88.gr"
SEED_ADMIN_PASSWORD=""
SEED_AGENT_PASSWORD=""

# --- First administrator (production bootstrap) ----------------------------
# `npm run admin:create` makes ADMIN_EMAIL the CRM's SUPER_ADMIN. It reuses an
# existing record (looked up by ADMIN_AUTH_UID, then email) instead of creating
# a duplicate, and refuses to add a second SUPER_ADMIN unless run with --force.
# ADMIN_AUTH_UID: the person's Supabase Auth user id, recorded on the staff
# record so the identity can never be mapped twice (optional).
# ADMIN_PASSWORD: optional, chosen by the account's owner. Set on a new account
# or on an existing one without a password (--reset-password replaces one).
# Leave it blank and the owner sets one at <CRM>/crm/forgot-password (needs SMTP).
# Set these for the one command, then remove them. Subsequent staff are
# provisioned through the CRM invitation flow instead. See docs/authentication.md.
ADMIN_EMAIL=""
ADMIN_AUTH_UID=""
ADMIN_PASSWORD=""
# Gate on the public XML/CSV feed URLs (Portal.settings.feedToken).
SEED_FEED_TOKEN="dev-feed-token"
